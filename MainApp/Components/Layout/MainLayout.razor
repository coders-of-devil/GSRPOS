@inherits LayoutComponentBase
@inject NavigationManager Nav

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

<div class="shell">
    <!-- Header / Topbar -->
    <header class="topbar" @onkeydown="HandleTopbarKey">
        <div class="topbar-left">
            <button class="icon-btn" title="Menu" aria-label="Open menu" @onclick="ToggleMenu">
                <i class="bi bi-list"></i>
            </button>
            <span class="brand">G-POS</span>

            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Search" @bind="searchQuery" />
            </div>
        </div>

        <div class="topbar-right">
            <button class="pill-btn success" @onclick="AddNewItem"><i class="bi bi-plus"></i> <span class="hide-sm">Add New</span></button>
            <button class="pill-btn dark" @onclick="OpenPOS"><i class="bi bi-laptop"></i> <span class="hide-sm">POS</span></button>
            <div class="divider"></div>
            <button class="icon-btn" title="Translate"><i class="bi bi-translate"></i></button>
            <button class="icon-btn" title="Notifications"><i class="bi bi-bell"></i></button>
            <button class="icon-btn" title="Settings" @onclick="GoToSettings"><i class="bi bi-gear"></i></button>
            <img src="images/user-avatar.png" class="avatar" alt="User" />
            <button class="icon-btn" title="Logout"><i class="bi bi-box-arrow-right"></i></button>
        </div>
    </header>

    <!-- Slide-in Drawer -->
    <div class="drawer @(IsMenuOpen ? "open" : null)" aria-hidden="@(!IsMenuOpen)">
        <div class="drawer-overlay" @onclick="CloseMenu"></div>

        <aside class="drawer-panel" role="dialog" aria-modal="true" aria-label="Main menu">
            <div class="drawer-header">
                <span class="brand small">Navigation</span>
                <button class="icon-btn" aria-label="Close menu" @onclick="CloseMenu">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="drawer-body">
                <NavMenu CloseMenu="CloseMenu" />
            </div>
        </aside>
    </div>

    <!-- Main content -->
    <main class="content-area">
        @Body
    </main>

    <Toast />
</div>

@code {
    private string? searchQuery;
    private bool IsMenuOpen;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += (_, __) => InvokeAsync(CloseMenu); // close on route change
    }

    private void ToggleMenu() => IsMenuOpen = !IsMenuOpen;
    private Task CloseMenu()
    {
        IsMenuOpen = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void HandleTopbarKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && IsMenuOpen)
            CloseMenu();
    }

    private void AddNewItem() { /* your logic */ }
    private void OpenPOS() => Nav.NavigateTo("/Pos");
    private void GoToSettings() => Nav.NavigateTo("/settings");
}
