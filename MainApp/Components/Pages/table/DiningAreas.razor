@page "/tables/areas"
@inject IDiningAreaService AreaService
@inject NotificationService Notifier
@inject IJSRuntime JS
@inject FileLogger Logger
@inject NavigationManager Nav

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h4>Dining Areas</h4>
        <small class="text-muted">Manage dining areas of the restaurant</small>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-secondary btn-sm" @onclick="GoLists">
            <i class="bi bi-plus-arrow me-1"></i> Tables
        </button>
        <button class="btn btn-primary" @onclick="ShowAddModal">
            <i class="bi bi-plus-circle me-1"></i> Add Area
        </button>
    </div>
</div>

<div class="card">
    <div class="card-body table-responsive">
        <div class="d-flex flex-wrap gap-2 mb-3 align-items-center justify-content-between">
            <div class="input-group" style="max-width: 300px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input class="form-control" @bind="searchTerm" @bind:event="oninput" placeholder="Search areas..." />
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <select class="form-select" style="width: 160px;" @bind="selectedStatus">
                    <option value="All">All</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>

                @if (areas.Any(a => a.IsSelected))
                {
                    <button class="btn btn-danger" @onclick="() => showBulkDeleteConfirm = true">
                        <i class="bi bi-trash me-1"></i> Delete Selected
                    </button>
                }
            </div>
        </div>

        @if (PaginatedAreas.Any())
        {
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th style="width: 40px;"><input type="checkbox" @onchange="ToggleAll" /></th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Reservable</th>
                        <th>Sort Order</th>
                        <th>Status</th>
                        <th style="width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in PaginatedAreas)
                    {
                        <tr>
                            <td><input type="checkbox" @bind="a.IsSelected" /></td>
                            <td>@a.Name</td>
                            <td>@a.Description</td>
                            <td>@(a.IsReservable ? "✔" : "✘")</td>
                            <td>@a.SortOrder</td>
                            <td>
                                <span class="badge @(a.IsActive ? "bg-success" : "bg-secondary")">
                                    @(a.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => Edit(a)"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmSingleDelete(a.Id)"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">No areas found.</div>
        }

        <!-- Pagination -->
        <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
            <div>
                Showing @((currentPage - 1) * pageSize + 1) to
                @((currentPage - 1) * pageSize + PaginatedAreas.Count) of @FilteredAreas.Count areas
            </div>
            <div class="d-flex align-items-center gap-2">
                <label>Rows per page:</label>
                <select class="form-select form-select-sm" style="width: 80px;" @bind="pageSize">
                    <option>5</option>
                    <option>10</option>
                    <option>25</option>
                </select>
                <button class="btn btn-outline-secondary btn-sm" @onclick="PrevPage">Previous</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="NextPage">Next</button>
            </div>
        </div>
    </div>
</div>

@if (showForm)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <EditForm Model="formModel" OnValidSubmit="Save">
                    <div class="modal-header">
                        <h5 class="modal-title">@((formModel.Id == 0) ? "Create" : "Edit") Area</h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <InputText class="form-control" @bind-Value="formModel.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <InputText class="form-control" @bind-Value="formModel.Description" />
                        </div>
                        <div class="form-check form-switch mb-3">
                            <InputCheckbox class="form-check-input" @bind-Value="formModel.IsReservable" />
                            <label class="form-check-label">Reservable</label>
                        </div>
                        <div class="form-check form-switch mb-3">
                            <InputCheckbox class="form-check-input" @bind-Value="formModel.IsActive" />
                            <label class="form-check-label">Active</label>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Sort Order</label>
                            <InputNumber class="form-control" @bind-Value="formModel.SortOrder" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" @onclick="CloseModal">Cancel</button>
                        <button class="btn btn-primary" type="submit">Save</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<ConfirmationModal Show="@showBulkDeleteConfirm"
                   Title="Delete Selected Areas"
                   Message="Are you sure you want to delete the selected areas?"
                   OnConfirm="ConfirmBulkDelete"
                   OnCancel="() => showBulkDeleteConfirm = false" />

<ConfirmationModal Show="@showSingleDeleteConfirm"
                   Title="Delete Area"
                   Message="Are you sure you want to delete this area?"
                   OnConfirm="ConfirmSingleDelete"
                   OnCancel="() => showSingleDeleteConfirm = false" />

@code {
    List<DiningAreaViewModel> areas = new();
    DiningAreaViewModel formModel = new();
    bool showForm = false;
    bool showBulkDeleteConfirm = false;
    bool showSingleDeleteConfirm = false;
    long selectedAreaId = 0;

    string searchTerm = "";
    int currentPage = 1;
    int pageSize = 10;
    string selectedStatus = "All";

    protected override async Task OnInitializedAsync() => await LoadAreas();

    async Task LoadAreas()
    {
        var all = await AreaService.GetAllAsync();
        areas = all.Select(DiningAreaMappings.ToViewModel).ToList();
    }

    void ShowAddModal()
    {
        formModel = new();
        showForm = true;
    }

    void Edit(DiningAreaViewModel a)
    {
        formModel = new DiningAreaViewModel
        {
            Id = a.Id,
            Name = a.Name,
            Description = a.Description,
            SortOrder = a.SortOrder,
            IsReservable = a.IsReservable,
            IsActive = a.IsActive
        };
        showForm = true;
    }

    void CloseModal() => showForm = false;

    async Task Save()
    {
        try
        {
            var model = DiningAreaMappings.ToEntity(formModel);
            if (formModel.Id == 0)
            {
                await AreaService.AddAsync(model);
                Notifier.Notify("✅ Area created successfully", "success");
            }
            else
            {
                await AreaService.UpdateAsync(model);
                Notifier.Notify("✏️ Area updated successfully", "info");
            }
            await LoadAreas();
            showForm = false;
        }
        catch (Exception ex)
        {
            Logger.Log(ex.ToString(), "SaveArea");
            Notifier.Notify($"❌ Failed: {ex.Message}", "error");
        }
    }

    void ConfirmSingleDelete(long id)
    {
        selectedAreaId = id;
        showSingleDeleteConfirm = true;
    }

    async Task ConfirmSingleDelete()
    {
        try
        {
            await AreaService.DeleteAsync(selectedAreaId);
            Notifier.Notify("🗑 Deleted", "warning");
            await LoadAreas();
        }
        catch (Exception ex)
        {
            Logger.Log(ex.ToString(), "DeleteArea");
            Notifier.Notify($"❌ Delete failed: {ex.Message}", "error");
        }
        finally
        {
            selectedAreaId = 0;
            showSingleDeleteConfirm = false;
        }
    }

    async Task ConfirmBulkDelete()
    {
        var selectedIds = areas.Where(a => a.IsSelected).Select(a => a.Id).ToList();
        foreach (var id in selectedIds)
        {
            await AreaService.DeleteAsync(id);
        }
        Notifier.Notify("🗑 Selected areas deleted", "warning");
        await LoadAreas();
        showBulkDeleteConfirm = false;
    }

    void ToggleAll(ChangeEventArgs e)
    {
        bool value = (bool)e.Value;
        foreach (var a in areas) a.IsSelected = value;
    }

    List<DiningAreaViewModel> FilteredAreas => areas
        .Where(a =>
            (string.IsNullOrWhiteSpace(searchTerm) || a.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) &&
            (selectedStatus == "All" || (selectedStatus == "Active" && a.IsActive) || (selectedStatus == "Inactive" && !a.IsActive)))
        .ToList();

    List<DiningAreaViewModel> PaginatedAreas => FilteredAreas
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    void PrevPage() { if (currentPage > 1) currentPage--; }
    void NextPage() { if (currentPage < Math.Ceiling((double)FilteredAreas.Count / pageSize)) currentPage++; }
    void GoLists() => Nav.NavigateTo("/table/tables");

    async Task ExportToExcel()
    {
        using var workbook = new XLWorkbook();
        var ws = workbook.Worksheets.Add("Areas");
        ws.Cell(1, 1).Value = "Name";
        ws.Cell(1, 2).Value = "Description";
        ws.Cell(1, 3).Value = "Reservable";
        ws.Cell(1, 4).Value = "SortOrder";
        ws.Cell(1, 5).Value = "Status";

        for (int i = 0; i < FilteredAreas.Count; i++)
        {
            var a = FilteredAreas[i];
            ws.Cell(i + 2, 1).Value = a.Name;
            ws.Cell(i + 2, 2).Value = a.Description;
            ws.Cell(i + 2, 3).Value = a.IsReservable ? "Yes" : "No";
            ws.Cell(i + 2, 4).Value = a.SortOrder;
            ws.Cell(i + 2, 5).Value = a.IsActive ? "Active" : "Inactive";
        }
        ws.Columns().AdjustToContents();

        using var stream = new MemoryStream();
        workbook.SaveAs(stream);
        stream.Seek(0, SeekOrigin.Begin);
        var fileName = $"Areas_{DateTime.UtcNow:yyyyMMdd_HHmmss}.xlsx";
        await TriggerDownload(fileName, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", stream.ToArray());
    }

    async Task TriggerDownload(string fileName, string mime, byte[] data)
    {
        using var streamRef = new DotNetStreamReference(new MemoryStream(data));
        await JS.InvokeVoidAsync("downloadFileFromStream", fileName, mime, streamRef);
    }
}
