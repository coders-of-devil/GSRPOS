@page "/Pos"
@inject IMenuCategoryService CategoryService
@inject IMenuItemService ItemService
@inject IMenuItemPricingService PricingService
@inject IOrderService OrderService
@inject IOrderItemService OrderItemService
@inject NavigationManager Nav
@inject NotificationService Notifier
@inject FileLogger Logger

<div class="d-flex flex-wrap gap-3">

    <!-- Left Section: Items -->
    <div class="flex-grow-1" style="min-width: 60%;">
        <!-- Category Tabs -->
        <ul class="nav nav-tabs mb-3">
            @foreach (var c in Categories)
            {
                <li class="nav-item">
                    <button class="nav-link @(SelectedCategoryId == c.Id ? "active" : "")"
                            @onclick="@(() => SelectCategory(c.Id))">
                        @c.Name
                    </button>
                </li>
            }
        </ul>

        <!-- Items Grid -->
        <div class="row g-3">
            @foreach (var item in Items)
            {
                <div class="col-6 col-md-3">
                    <div class="card h-100 text-center shadow-sm" @onclick="@(() => AddToCart(item))" style="cursor:pointer;">
                        <img src="@item.ImagePath" class="card-img-top" style="height:120px; object-fit:cover;" />
                        <div class="card-body p-2">
                            <h6 class="card-title">@item.Name</h6>
                            <div class="fw-bold text-primary">@item.Price.ToString("C")</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Right Section: Cart -->
    <div style="width: 360px;">
        <div class="card shadow-sm">
            <div class="card-header">
                <h6 class="mb-0">Table / Mode</h6>
                <div class="btn-group mt-2 w-100">
                    <button class="btn btn-outline-primary @(OrderMode == "DineIn" ? "active" : "")" @onclick="() => SetMode(" DineIn")">Dine In</button>
                    <button class="btn btn-outline-primary @(OrderMode == "ToGo" ? "active" : "")" @onclick="() => SetMode(" ToGo")">To Go</button>
                    <button class="btn btn-outline-primary @(OrderMode == "Delivery" ? "active" : "")" @onclick="() => SetMode(" Delivery")">Delivery</button>
                </div>
            </div>

            <div class="card-body">
                <!-- Cart Items -->
                @if (Cart.Any())
                {
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th style="width:80px;">Qty</th>
                                <th style="width:80px;" class="text-end">Price</th>
                                <th style="width:40px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ci in Cart)
                            {
                                <tr>
                                    <td>@ci.Name</td>
                                    <td>
                                        <div class="input-group input-group-sm">
                                            <button class="btn btn-outline-secondary" @onclick="@(() => DecreaseQty(ci))">-</button>
                                            <input type="text" class="form-control text-center" value="@ci.Qty" readonly />
                                            <button class="btn btn-outline-secondary" @onclick="@(() => IncreaseQty(ci))">+</button>
                                        </div>
                                    </td>
                                    <td class="text-end">@((ci.Qty * ci.Price).ToString("C"))</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="@(() => Remove(ci))">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-info">Cart is empty</div>
                }

                <!-- Totals -->
                <div class="mt-3">
                    <div class="d-flex justify-content-between">
                        <span>Subtotal</span>
                        <strong>@Subtotal.ToString("C")</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Discount</span>
                        <span class="text-success">-@Discount.ToString("C")</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between fw-bold">
                        <span>Total</span>
                        <span>@Total.ToString("C")</span>
                    </div>
                </div>
            </div>

            <div class="card-footer d-flex gap-2">
                <button class="btn btn-secondary w-100" @onclick="SaveDraft">Save</button>
                <button class="btn btn-primary w-100" @onclick="Pay">Pay</button>
                <button class="btn btn-outline-primary w-100" @onclick="PayLater">Pay Later</button>
            </div>
        </div>
    </div>
</div>

@code {
    // ======= Models =======
    class CartItemVM
    {
        public long ItemId { get; set; }
        public string Name { get; set; } = "";
        public decimal Price { get; set; }
        public int Qty { get; set; } = 1;
    }

    class ItemCardVM
    {
        public long Id { get; set; }
        public string Name { get; set; } = "";
        public string ImagePath { get; set; } = "/images/placeholder.png";
        public decimal Price { get; set; }
    }

    // ======= State =======
    List<MenuCategory> Categories = new();
    List<ItemCardVM> Items = new();
    List<CartItemVM> Cart = new();

    long SelectedCategoryId = 0;
    string OrderMode = "DineIn";

    decimal Subtotal => Cart.Sum(x => x.Price * x.Qty);
    decimal Discount = 0m; // extend later with coupons
    decimal Total => Subtotal - Discount;

    // ======= Lifecycle =======
    protected override async Task OnInitializedAsync()
    {
        Categories = await CategoryService.GetAllAsync();
        if (Categories.Any())
        {
            SelectedCategoryId = Categories.First().Id;
            await LoadItems();
        }
    }

    async Task LoadItems()
    {
        var items = await ItemService.GetByCategoryAsync(SelectedCategoryId);
        Items = new();
        foreach (var i in items)
        {
            var price = await PricingService.GetEffectiveBasePriceAsync(i.Id, DateTime.UtcNow);
            Items.Add(new ItemCardVM
            {
                Id = i.Id,
                Name = i.Name,
                ImagePath = string.IsNullOrEmpty(i.ImagePath) ? "/images/placeholder.png" : i.ImagePath,
                Price = price
            });
        }
    }

    // ======= Actions =======
    void SelectCategory(long id)
    {
        SelectedCategoryId = id;
        _ = LoadItems();
    }

    void AddToCart(ItemCardVM item)
    {
        var existing = Cart.FirstOrDefault(c => c.ItemId == item.Id);
        if (existing != null) existing.Qty++;
        else Cart.Add(new CartItemVM { ItemId = item.Id, Name = item.Name, Price = item.Price });
    }

    void IncreaseQty(CartItemVM ci) => ci.Qty++;
    void DecreaseQty(CartItemVM ci) { if (ci.Qty > 1) ci.Qty--; else Cart.Remove(ci); }
    void Remove(CartItemVM ci) => Cart.Remove(ci);

    void SetMode(string mode) => OrderMode = mode;

    async Task SaveDraft()
    {
        try
        {
            var order = new Order
            {
                OrderNumber = Guid.NewGuid().ToString("N")[..6],
                OrderDate = DateOnly.FromDateTime(DateTime.Today),
                Status = OrderStatusEnum.Draft,
                NetTotal = Total,
                GrossTotal = Subtotal
            };
            var orderId = await OrderService.AddAsync(order);

            foreach (var ci in Cart)
            {
                await OrderItemService.AddAsync(new OrderItem
                {
                    OrderId = orderId,
                    MenuItemId = ci.ItemId,
                    Quantity = ci.Qty,
                    Price = ci.Price,
                    NetAmount = ci.Price * ci.Qty
                });
            }

            Notifier.Notify("💾 Draft order saved", "info");
        }
        catch (Exception ex)
        {
            Logger.Log(ex.ToString(), "SaveDraft");
            Notifier.Notify("❌ Failed to save draft order", "error");
        }
    }

    async Task Pay()
    {
        // extend later with payment modal
        Notifier.Notify("💳 Paid", "success");
    }

    async Task PayLater()
    {
        Notifier.Notify("🕒 Order marked for Pay Later", "info");
    }
}
