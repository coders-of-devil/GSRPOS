@page "/kitchen/devices"
@inject IKitchenDeviceService DeviceService
@inject IPreparationAreaService AreaService
@inject NotificationService Notifier
@inject IJSRuntime JS
@inject FileLogger Logger
@inject NavigationManager Nav

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h4>Kitchen Devices</h4>
        <small class="text-muted">Manage your kitchen printers & devices</small>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-outline-success btn-sm" @onclick="ExportToExcel">
            <i class="bi bi-file-earmark-excel me-1"></i> Excel
        </button>
        <button class="btn btn-primary" @onclick="ShowAddModal">
            <i class="bi bi-plus-circle me-1"></i> Add Device
        </button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="GoBackToItems">
            <i class="bi bi-arrow-left me-1"></i> Back to Items
        </button>
    </div>
</div>

<div class="card">
    <div class="card-body table-responsive">
        <div class="d-flex flex-wrap gap-2 mb-3 align-items-center justify-content-between">
            <div class="input-group" style="max-width: 300px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input class="form-control" @bind="searchTerm" @bind:event="oninput" placeholder="Search devices..." />
            </div>

            @if (devices.Any(d => d.IsSelected))
            {
                <button class="btn btn-danger" @onclick="() => showBulkDeleteConfirm = true">
                    <i class="bi bi-trash me-1"></i> Delete Selected
                </button>
            }
        </div>

        @if (PaginatedDevices.Any())
        {
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th><input type="checkbox" @onchange="ToggleAll" /></th>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Connection</th>
                        <th>IP</th>
                        <th>Port</th>
                        <th>Area</th>
                        <th>Status</th>
                        <th>Copies</th>
                        <th style="width:150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in PaginatedDevices)
                    {
                        <tr>
                            <td><input type="checkbox" @bind="d.IsSelected" /></td>
                            <td>@d.Name</td>
                            <td>@d.Type</td>
                            <td>@d.ConnectionType</td>
                            <td>@d.IpAddress</td>
                            <td>@d.Port</td>
                            <td>@d.PreparationAreaName</td>
                            <td>
                                <span class="badge @(d.IsActive ? "bg-success" : "bg-secondary")">
                                    @(d.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>@d.DefaultCopies</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => Edit(d)"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmSingleDelete(d.Id)"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">No devices found.</div>
        }
    </div>
</div>

<!-- Add/Edit Modal -->
@if (showForm)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <EditForm Model="formModel" OnValidSubmit="Save">
                    <div class="modal-header">
                        <h5 class="modal-title">@((formModel.Id == 0) ? "Add Device" : "Edit Device")</h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label>Preparation Area</label>
                                <select class="form-select" @bind="formModel.PreparationAreaId">
                                    <option value="">-None-</option>
                                    @foreach (var area in Areas)
                                    {
                                        <option value="@area.Id">@area.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label>Name</label>
                                <InputText class="form-control" @bind-Value="formModel.Name" />
                            </div>
                            <div class="col-md-6">
                                <label>Type</label>
                                <InputText class="form-control" @bind-Value="formModel.Type" />
                            </div>
                            <div class="col-md-6">
                                <label>Connection</label>
                                <InputText class="form-control" @bind-Value="formModel.ConnectionType" />
                            </div>
                            <div class="col-md-6">
                                <label>IP Address</label>
                                <InputText class="form-control" @bind-Value="formModel.IpAddress" />
                            </div>
                            <div class="col-md-6">
                                <label>Port</label>
                                <InputText class="form-control" @bind-Value="formModel.Port" />
                            </div>
                            <div class="col-md-6">
                                <label>Model</label>
                                <InputText class="form-control" @bind-Value="formModel.Model" />
                            </div>
                            <div class="col-md-6">
                                <label>Default Copies</label>
                                <InputNumber class="form-control" @bind-Value="formModel.DefaultCopies" />
                            </div>
                            <div class="form-check form-switch mb-3">
                                <InputCheckbox class="form-check-input" @bind-Value="formModel.IsActive" />
                                <label class="form-check-label">Active</label>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" @onclick="CloseModal">Cancel</button>
                        <button class="btn btn-primary" type="submit">Save</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<ConfirmationModal Show="@showBulkDeleteConfirm"
                   Title="Delete Selected Devices"
                   Message="Are you sure you want to delete the selected devices?"
                   OnConfirm="ConfirmBulkDelete"
                   OnCancel="() => showBulkDeleteConfirm = false" />

<ConfirmationModal Show="@showSingleDeleteConfirm"
                   Title="Delete Device"
                   Message="Are you sure you want to delete this device?"
                   OnConfirm="ConfirmSingleDelete"
                   OnCancel="() => showSingleDeleteConfirm = false" />

@code {
    List<KitchenDeviceViewModel> devices = new();
    List<PreparationArea> Areas = new();
    KitchenDeviceViewModel formModel = new();

    bool showForm = false;
    bool showBulkDeleteConfirm = false;
    bool showSingleDeleteConfirm = false;
    long selectedDeviceId = 0;

    string searchTerm = "";
    int currentPage = 1;
    int pageSize = 10;

    protected override async Task OnInitializedAsync() => await LoadDevices();

    async Task LoadDevices()
    {
        var all = await DeviceService.GetAllAsync();
        devices = all.Select(KitchenMapping.ToViewModel).ToList();

        Areas = await AreaService.GetAllPreparationAreaAsync();
    }

    void ShowAddModal()
    {
        formModel = new();
        showForm = true;
    }

    void Edit(KitchenDeviceViewModel d)
    {
        formModel = new KitchenDeviceViewModel
        {
            Id = d.Id,
            Name = d.Name,
            Type = d.Type,
            ConnectionType = d.ConnectionType,
            IpAddress = d.IpAddress,
            Port = d.Port,
            Model = d.Model,
            PreparationAreaId = d.PreparationAreaId,
            IsActive = d.IsActive,
            DefaultCopies = d.DefaultCopies
        };
        showForm = true;
    }

    void CloseModal() => showForm = false;

    async Task Save()
    {
        try
        {
            var entity = formModel.ToEntity();
            if (formModel.Id == 0)
            {
                await DeviceService.AddAsync(entity);
                Notifier.Notify("✅ Device created successfully", "success");
            }
            else
            {
                await DeviceService.UpdateAsync(entity);
                Notifier.Notify("✏️ Device updated successfully", "info");
            }
            await LoadDevices();
            showForm = false;
        }
        catch (Exception ex)
        {
            Logger.Log(ex.ToString(), "SaveDevice");
            Notifier.Notify($"❌ Save failed: {ex.Message}", "error");
        }
    }

    void ConfirmSingleDelete(long id)
    {
        selectedDeviceId = id;
        showSingleDeleteConfirm = true;
    }

    async Task ConfirmSingleDelete()
    {
        try
        {
            await DeviceService.DeleteAsync(selectedDeviceId);
            Notifier.Notify("🗑 Device deleted", "warning");
            await LoadDevices();
        }
        catch (Exception ex)
        {
            Logger.Log(ex.ToString(), "DeleteDevice");
            Notifier.Notify($"❌ Delete failed: {ex.Message}", "error");
        }
        finally
        {
            selectedDeviceId = 0;
            showSingleDeleteConfirm = false;
        }
    }

    async Task ConfirmBulkDelete()
    {
        foreach (var id in devices.Where(d => d.IsSelected).Select(d => d.Id).ToList())
        {
            await DeviceService.DeleteAsync(id);
        }
        Notifier.Notify("🗑 Selected devices deleted", "warning");
        await LoadDevices();
        showBulkDeleteConfirm = false;
    }

    void ToggleAll(ChangeEventArgs e)
    {
        bool value = (bool)e.Value;
        foreach (var d in devices) d.IsSelected = value;
    }

    List<KitchenDeviceViewModel> FilteredDevices => devices
        .Where(d => string.IsNullOrWhiteSpace(searchTerm) ||
            d.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            d.Type.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            d.IpAddress.Contains(searchTerm))
        .ToList();

    List<KitchenDeviceViewModel> PaginatedDevices => FilteredDevices
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    void GoBackToItems() => Nav.NavigateTo("/menu/items");

    void PrevPage() { if (currentPage > 1) currentPage--; }
    void NextPage() { if (currentPage < Math.Ceiling((double)FilteredDevices.Count / pageSize)) currentPage++; }

    async Task ExportToExcel()
    {
        using var wb = new XLWorkbook();
        var ws = wb.Worksheets.Add("Devices");
        ws.Cell(1, 1).Value = "Name";
        ws.Cell(1, 2).Value = "Type";
        ws.Cell(1, 3).Value = "Connection";
        ws.Cell(1, 4).Value = "IP";
        ws.Cell(1, 5).Value = "Port";
        ws.Cell(1, 6).Value = "Area";
        ws.Cell(1, 7).Value = "Status";
        ws.Cell(1, 8).Value = "DefaultCopies";

        for (int i = 0; i < FilteredDevices.Count; i++)
        {
            var d = FilteredDevices[i];
            ws.Cell(i + 2, 1).Value = d.Name;
            ws.Cell(i + 2, 2).Value = d.Type;
            ws.Cell(i + 2, 3).Value = d.ConnectionType;
            ws.Cell(i + 2, 4).Value = d.IpAddress;
            ws.Cell(i + 2, 5).Value = d.Port;
            ws.Cell(i + 2, 6).Value = d.PreparationAreaName;
            ws.Cell(i + 2, 7).Value = d.IsActive ? "Active" : "Inactive";
            ws.Cell(i + 2, 8).Value = d.DefaultCopies;
        }
        ws.Columns().AdjustToContents();

        using var stream = new MemoryStream();
        wb.SaveAs(stream);
        stream.Seek(0, SeekOrigin.Begin);

        var fileName = $"KitchenDevices_{DateTime.UtcNow:yyyyMMdd_HHmmss}.xlsx";
        await TriggerDownload(fileName, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", stream.ToArray());
    }

    async Task TriggerDownload(string fileName, string mime, byte[] data)
    {
        using var streamRef = new DotNetStreamReference(new MemoryStream(data));
        await JS.InvokeVoidAsync("downloadFileFromStream", fileName, mime, streamRef);
    }
}

