@page "/menu/modifiers"
@using System.ComponentModel.DataAnnotations
@inject IModifierService ModifierService
@inject IModifierGroupService GroupService
@inject NotificationService Notifier
@inject FileLogger Logger
@inject NavigationManager Nav

<!-- Header -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h4>Modifiers</h4>
        <small class="text-muted">Create and manage modifiers</small>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-success btn-sm" @onclick="ExportExcel">
            <i class="bi bi-file-earmark-excel me-1"></i> Excel
        </button>
        <button class="btn btn-primary" @onclick="ShowAddModifier">
            <i class="bi bi-plus-circle me-1"></i> New Modifier
        </button>
    </div>
</div>

<!-- Card -->
<div class="card">
    <div class="card-body table-responsive">

        <!-- Filters -->
        <div class="d-flex flex-wrap gap-2 mb-3 align-items-center justify-content-between">
            <div class="input-group" style="max-width: 320px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input class="form-control" @bind="search" @bind:event="oninput" placeholder="Search modifiers..." />
            </div>

            <div class="d-flex gap-2 flex-wrap">
                @if (modifiers.Any(x => x.IsSelected))
                {
                    <button class="btn btn-danger" @onclick="() => showBulkDelete = true">
                        <i class="bi bi-trash me-1"></i> Delete Selected
                    </button>
                }
            </div>
        </div>

        <!-- Table -->
        @if (Paged.Any())
        {
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width:40px;"><input type="checkbox" @onchange="ToggleAll" /></th>
                        <th @onclick="() => SortBy(nameof(ModifierViewModel.Name))" style="cursor:pointer;">
                            Name @SortIcon(nameof(ModifierViewModel.Name))
                        </th>
                        <th>Group</th>
                        <th @onclick="() => SortBy(nameof(ModifierViewModel.Price))" style="cursor:pointer;">
                            Price @SortIcon(nameof(ModifierViewModel.Price))
                        </th>
                        <th>Default</th>
                        <th>Display Order</th>
                        <th style="width:150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Paged)
                    {
                        <tr>
                            <td><input type="checkbox" @bind="m.IsSelected" /></td>
                            <td>@m.Name</td>
                            <td>@m.GroupName</td>
                            <td>@m.Price.ToString("0.00")</td>
                            <td>
                                <span class="badge bg-@(m.IsDefault ? "success" : "secondary")">
                                    @(m.IsDefault ? "Yes" : "No")
                                </span>
                            </td>
                            <td>@m.DisplayOrder</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="@(() => EditModifier(m))">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="@(() => ConfirmDelete(m.Id))">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">No modifiers found.</div>
        }

        <!-- Pagination -->
        <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
            <div>
                Showing @((page - 1) * pageSize + 1) to
                @((page - 1) * pageSize + Paged.Count) of @Filtered.Count modifiers
            </div>
            <div class="d-flex align-items-center gap-2">
                <label>Rows per page:</label>
                <select class="form-select form-select-sm" style="width: 90px;" @bind="pageSize">
                    <option>5</option>
                    <option>10</option>
                    <option>25</option>
                </select>
                <button class="btn btn-outline-secondary btn-sm" @onclick="Prev">Previous</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="Next">Next</button>
            </div>
        </div>
    </div>
</div>

@* ---------------- Add/Edit Modifier Modal ---------------- *@
@if (showModifierModal)
{
    <EditForm Model="modForm" OnValidSubmit="SaveModifier">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">@((modForm.Id == 0) ? "Add Modifier" : "Edit Modifier")</h5>
                        <button type="button" class="btn-close" @onclick="CloseModifierModal"></button>
                    </div>

                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Group</label>
                                <div class="input-group">
                                    <select class="form-select" @bind="modForm.ModifierGroupId">
                                        <option value="0">-- Select Group --</option>
                                        @foreach (var g in Groups)
                                        {
                                            <option value="@g.Id">@g.Name</option>
                                        }
                                    </select>
                                    <button type="button" class="btn btn-outline-primary" title="Add Group" @onclick="ShowGroupModal">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary" title="Manage Groups" @onclick="GoGroups">
                                        <i class="bi bi-arrow-right"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Name</label>
                                <InputText class="form-control" @bind-Value="modForm.Name" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Price</label>
                                <InputNumber class="form-control" @bind-Value="modForm.Price" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Display Order</label>
                                <InputNumber class="form-control" @bind-Value="modForm.DisplayOrder" />
                            </div>

                            <div class="col-md-6 d-flex align-items-center">
                                <div class="form-check">
                                    <InputCheckbox class="form-check-input" @bind-Value="modForm.IsDefault" id="modDefault" />
                                    <label class="form-check-label" for="modDefault">Default</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" @onclick="CloseModifierModal">Cancel</button>
                        <button class="btn btn-primary" type="submit">Save</button>
                    </div>

                </div>
            </div>
        </div>
    </EditForm>
}

@* ---------------- Inline Add Group Modal ---------------- *@
@if (showGroupModal)
{
    <EditForm Model="groupForm" OnValidSubmit="SaveGroupInline">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Add Modifier Group</h5>
                        <button type="button" class="btn-close" @onclick="CloseGroupModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <InputText class="form-control" @bind-Value="groupForm.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <InputText class="form-control" @bind-Value="groupForm.Description" />
                        </div>
                        <div class="form-check mb-2">
                            <InputCheckbox class="form-check-input" @bind-Value="groupForm.IsRequired" />
                            <label class="form-check-label">Required</label>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Max Selectable</label>
                            <InputNumber class="form-control" @bind-Value="groupForm.MaxSelectable" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Display Order</label>
                            <InputNumber class="form-control" @bind-Value="groupForm.DisplayOrder" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" @onclick="CloseGroupModal">Cancel</button>
                        <button class="btn btn-primary" type="submit">Save</button>
                    </div>
                </div>
            </div>
        </div>
    </EditForm>
}

<!-- Confirmations -->
<ConfirmationModal Show="@showConfirmDelete"
                   Title="Delete Modifier"
                   Message="Are you sure you want to delete this modifier?"
                   OnConfirm="ConfirmDelete"
                   OnCancel="() => showConfirmDelete = false" />

<ConfirmationModal Show="@showBulkDelete"
                   Title="Delete Selected Modifiers"
                   Message="Are you sure you want to delete the selected modifiers?"
                   OnConfirm="ConfirmBulkDelete"
                   OnCancel="() => showBulkDelete = false" />

@code {
    // ------------ Page state ------------
    List<ModifierViewModel> modifiers = new();
    List<ModifierGroupViewModel> Groups = new();

    string search = "";
    int page = 1;
    int pageSize = 10;
    string sortColumn = nameof(ModifierViewModel.Name);
    bool sortAsc = true;

    bool showModifierModal = false;
    bool showGroupModal = false;
    bool showConfirmDelete = false;
    bool showBulkDelete = false;
    long selectedId = 0;

    ModifierViewModel modForm = new();
    ModifierGroupViewModel groupForm = new();

    // ------------ Lifecycle ------------
    protected override async Task OnInitializedAsync()
    {
        await LoadGroups();
        await LoadModifiers();
    }

    async Task LoadGroups()
    {
        Groups = (await GroupService.GetAllAsync())
            .Select(g => g.ToGroupViewModel()).ToList();
    }

    async Task LoadModifiers()
    {
        var all = await ModifierService.GetAllAsync();
        modifiers = all.Select(m => m.ToModifierViewModel()).ToList();
    }

    // ------------ Filtering / Sorting / Paging ------------
    List<ModifierViewModel> Filtered => modifiers
        .Where(m => string.IsNullOrWhiteSpace(search) ||
                   m.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                   m.GroupName.Contains(search, StringComparison.OrdinalIgnoreCase))
        .OrderBy(m => GetSortValue(m), sortAsc
            ? Comparer<object>.Default
            : Comparer<object>.Create((a, b) => Comparer<object>.Default.Compare(b, a)))
        .ToList();

    object GetSortValue(ModifierViewModel m) => sortColumn switch
    {
        nameof(ModifierViewModel.Name) => m.Name,
        nameof(ModifierViewModel.Price) => m.Price,
        _ => m.Name
    };

    void SortBy(string column)
    {
        if (sortColumn == column) sortAsc = !sortAsc;
        else { sortColumn = column; sortAsc = true; }
    }

    RenderFragment SortIcon(string column) => __builder =>
    {
        if (sortColumn == column)
            __builder.AddMarkupContent(0, $"<i class=\"bi bi-chevron-{(sortAsc ? "up" : "down")}\"></i>");
    };

    List<ModifierViewModel> Paged => Filtered
        .Skip((page - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    void Prev() { if (page > 1) page--; }
    void Next() { if (page < Math.Ceiling((double)Filtered.Count / pageSize)) page++; }

    void ToggleAll(ChangeEventArgs e)
    {
        var val = (bool)e.Value;
        foreach (var m in modifiers) m.IsSelected = val;
    }

    // ------------ List actions ------------
    void ShowAddModifier()
    {
        modForm = new ModifierViewModel { IsDefault = false };
        showModifierModal = true;
    }

    void EditModifier(ModifierViewModel src)
    {
        modForm = new ModifierViewModel
        {
            Id = src.Id,
            Name = src.Name,
            ModifierGroupId = src.ModifierGroupId,
            Price = src.Price,
            DisplayOrder = src.DisplayOrder,
            IsDefault = src.IsDefault
        };
        showModifierModal = true;
    }

    void CloseModifierModal() => showModifierModal = false;

    void ConfirmDelete(long id) { selectedId = id; showConfirmDelete = true; }

    async Task ConfirmDelete()
    {
        try
        {
            await ModifierService.DeleteAsync(selectedId);
            Notifier.Notify("🗑 Deleted", "warning");
            await LoadModifiers();
        }
        catch (Exception ex)
        {
            Logger.Log(ex.ToString(), "DeleteModifier");
            Notifier.Notify($"❌ {ex.Message}", "error");
        }
        finally
        {
            selectedId = 0;
            showConfirmDelete = false;
        }
    }

    async Task ConfirmBulkDelete()
    {
        var ids = modifiers.Where(x => x.IsSelected).Select(x => x.Id).ToList();
        foreach (var id in ids)
        {
            try { await ModifierService.DeleteAsync(id); }
            catch (Exception ex)
            {
                Logger.Log(ex.ToString(), "BulkDeleteModifier");
                Notifier.Notify($"❌ Failed to delete ID {id}", "error");
            }
        }
        Notifier.Notify("🗑 Selected modifiers deleted", "warning");
        await LoadModifiers();
        showBulkDelete = false;
    }

    // ------------ Save Modifier ------------
    async Task SaveModifier()
    {
        try
        {
            if (modForm.ModifierGroupId <= 0)
            {
                Notifier.Notify("Select a group.", "error"); return;
            }

            if (await ModifierService.ExistsByNameAsync(modForm.Name, modForm.ModifierGroupId, modForm.Id == 0 ? null : modForm.Id))
            {
                Notifier.Notify("Modifier with same name exists in this group.", "error");
                return;
            }

            var entity = modForm.ToModifierEntity();

            if (modForm.Id == 0)
            {
                await ModifierService.AddAsync(entity);
                Notifier.Notify("✅ Modifier created", "success");
            }
            else
            {
                await ModifierService.UpdateAsync(entity);
                Notifier.Notify("✏️ Modifier updated", "info");
            }

            await LoadModifiers();
            showModifierModal = false;
        }
        catch (Exception ex)
        {
            Logger.Log(ex.ToString(), "SaveModifier");
            Notifier.Notify($"❌ {ex.Message}", "error");
        }
    }

    // ------------ Inline Add Group ------------
    void ShowGroupModal() { groupForm = new(); showGroupModal = true; }
    void CloseGroupModal() => showGroupModal = false;
    void GoGroups() => Nav.NavigateTo("/menu/modifier-groups");

    async Task SaveGroupInline()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(groupForm.Name))
            { Notifier.Notify("Group name is required.", "error"); return; }

            if (await GroupService.ExistsByNameAsync(groupForm.Name))
            { Notifier.Notify("Group name already exists.", "error"); return; }

            var newId = await GroupService.AddAsync(groupForm.ToGroupEntity());
            Groups = (await GroupService.GetAllAsync()).Select(g => g.ToGroupViewModel()).ToList();

            modForm.ModifierGroupId = newId; // auto select new group
            Notifier.Notify("✅ Group added", "success");
            showGroupModal = false;
        }
        catch (Exception ex)
        {
            Logger.Log(ex.ToString(), "SaveGroupInline");
            Notifier.Notify($"❌ {ex.Message}", "error");
        }
    }

    // ------------ Export stubs ------------
    async Task ExportExcel() { /* similar to Pricelists */ }
}
