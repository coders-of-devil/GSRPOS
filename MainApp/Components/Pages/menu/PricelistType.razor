@page "/menu/pricelisttypes"
@inject IPricelistService PricelistService
@inject NotificationService Notifier
@inject FileLogger Logger
@inject NavigationManager Nav

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h4>Pricelist Types</h4>
        <small class="text-muted">Manage pricelist types</small>
    </div>
    <div class="d-flex gap-2">
        
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-secondary" @onclick="GoLists">
            <i class="bi bi-plus-arrow me-1"></i> Pricelist
        </button>
        <button class="btn btn-primary" @onclick="ShowAddType">
            <i class="bi bi-plus-circle me-1"></i> Add Type
        </button>
    </div>
</div>
<hr />

<div class="card">
    <div class="card-body table-responsive">
        <div class="d-flex flex-wrap gap-2 mb-3 align-items-center justify-content-between">
            <div class="input-group" style="max-width: 300px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input class="form-control" @bind="search" @bind:event="oninput" placeholder="Search types..." />
            </div>
            @if (types.Any(t => t.IsSelected))
            {
                <button class="btn btn-danger" @onclick="ConfirmBulkDelete">
                    <i class="bi bi-trash me-1"></i> Delete Selected
                </button>
            }
        </div>

        @if (Paged.Any())
        {
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th style="width:40px;"><input type="checkbox" @onchange="ToggleAll" /></th>
                        <th>Name</th>
                        <th>Description</th>
                        <th style="width:120px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Paged)
                    {
                        <tr>
                            <td><input type="checkbox" @bind="t.IsSelected" /></td>
                            <td>@t.Name</td>
                            <td>@t.Description</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="@(() => EditType(t))"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="@(() => ConfirmDelete(t.Id))"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">No types found.</div>
        }

        <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
            <div>Showing @((page - 1) * pageSize + 1) to @((page - 1) * pageSize + Paged.Count) of @Filtered.Count types</div>
            <div class="d-flex align-items-center gap-2">
                <label>Rows per page:</label>
                <select class="form-select form-select-sm" style="width:80px;" @bind="pageSize">
                    <option>5</option>
                    <option>10</option>
                    <option>25</option>
                </select>
                <button class="btn btn-outline-secondary btn-sm" @onclick="Prev">Previous</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="Next">Next</button>
            </div>
        </div>
    </div>
</div>

@if (showTypeModal)
{
    <EditForm Model="typeForm" OnValidSubmit="SaveType">
        <DataAnnotationsValidator />
        <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@((typeForm.Id == 0) ? "Add Type" : "Edit Type")</h5>
                        <button type="button" class="btn-close" @onclick="CloseTypeModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <InputText class="form-control" @bind-Value="typeForm.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <InputText class="form-control" @bind-Value="typeForm.Description" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" @onclick="CloseTypeModal">Cancel</button>
                        <button class="btn btn-primary" type="submit">Save</button>
                    </div>
                </div>
            </div>
        </div>
    </EditForm>
}

<ConfirmationModal Show="@showConfirmDelete" Title="Delete Type"
                   Message="Are you sure you want to delete this type?"
                   OnConfirm="ConfirmDelete" OnCancel="() => showConfirmDelete=false" />

<ConfirmationModal Show="@showBulkDelete" Title="Delete Selected Types"
                   Message="Are you sure you want to delete the selected types?"
                   OnConfirm="ConfirmBulkDelete" OnCancel="() => showBulkDelete=false" />

@code {
    List<PricelistTypeViewModel> types = new();
    PricelistTypeViewModel typeForm = new();
    bool showTypeModal = false;
    bool showConfirmDelete = false;
    bool showBulkDelete = false;
    long selectedTypeId = 0;

    string search = "";
    int page = 1;
    int pageSize = 10;

    protected override async Task OnInitializedAsync() => await Load();

    async Task Load()
    {
        var all = await PricelistService.GetAllPricelistTypesAsync();
        types = all.Select(PricelistMapping.ToTypeVm).ToList();
    }

    List<PricelistTypeViewModel> Filtered => types
      .Where(t => string.IsNullOrWhiteSpace(search)
        || t.Name.Contains(search, StringComparison.OrdinalIgnoreCase)
        || t.Description.Contains(search, StringComparison.OrdinalIgnoreCase))
      .ToList();

    List<PricelistTypeViewModel> Paged => Filtered.Skip((page - 1) * pageSize).Take(pageSize).ToList();

    void Prev() { if (page > 1) page--; }
    void Next() { if (page < Math.Ceiling((double)Filtered.Count / pageSize)) page++; }

    void ToggleAll(ChangeEventArgs e) { var v = (bool)e.Value; foreach (var t in types) t.IsSelected = v; }

    void ShowAddType() { typeForm = new(); showTypeModal = true; }
    void EditType(PricelistTypeViewModel t) { typeForm = new() { Id = t.Id, Name = t.Name, Description = t.Description }; showTypeModal = true; }
    void CloseTypeModal() { showTypeModal = false; }
    void GoLists() => Nav.NavigateTo("/menu/pricelists");

    async Task SaveType()
    {
        try
        {
            if (typeForm.Id == 0)
            {
                if (await PricelistService.ExistsTypeByNameAsync(typeForm.Name))
                { Notifier.Notify("Type name already exists.", "error"); return; }

                await PricelistService.AddPricelistTypeAsync(PricelistMapping.ToTypeEntity(typeForm));
                Notifier.Notify("✅ Type created", "success");
            }
            else
            {
                await PricelistService.UpdateTypeAsync(PricelistMapping.ToTypeEntity(typeForm));
                Notifier.Notify("✏️ Type updated", "info");
            }
            await Load();
            showTypeModal = false;
        }
        catch (Exception ex) { Logger.Log(ex.ToString(), "SaveType"); Notifier.Notify($"❌ {ex.Message}", "error"); }
    }

    void ConfirmDelete(long id) { selectedTypeId = id; showConfirmDelete = true; }
    async Task ConfirmDelete()
    {
        try { await PricelistService.DeleteTypeAsync(selectedTypeId); Notifier.Notify("🗑 Deleted", "warning"); await Load(); }
        catch (Exception ex) { Logger.Log(ex.ToString(), "DeleteType"); Notifier.Notify($"❌ {ex.Message}", "error"); }
        finally { selectedTypeId = 0; showConfirmDelete = false; }
    }

    async Task ConfirmBulkDelete()
    {
        var ids = types.Where(t => t.IsSelected).Select(t => t.Id).ToList();
        foreach (var id in ids)
        {
            try { await PricelistService.DeleteTypeAsync(id); }
            catch (Exception ex) { Logger.Log(ex.ToString(), "BulkDeleteType"); Notifier.Notify($"❌ Failed to delete ID {id}", "error"); }
        }
        Notifier.Notify("🗑 Selected types deleted", "warning");
        await Load();
        showBulkDelete = false;
    }
}
