@page "/menu/categories"
@inject IMenuCategoryService MenuCategoryService
@inject NotificationService Notifier
@inject IJSRuntime JS
@inject FileLogger Logger

<!-- Page Header -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h4>Menu Categories</h4>
        <small class="text-muted">Manage menu categories here</small>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-success btn-sm" @onclick="ExportToExcel">
            <i class="bi bi-file-earmark-excel me-1"></i> Excel
        </button>
        @* <button class="btn btn-outline-danger btn-sm" @onclick="ExportToPdf">
            <i class="bi bi-file-earmark-pdf me-1"></i> PDF
        </button> *@
        <button class="btn btn-primary" @onclick="ShowAddModal">
            <i class="bi bi-plus-circle me-1"></i> Add Category
        </button>
    </div>
</div>
<hr />

<!-- Main Table Card -->
<div class="card">
    <div class="card-body table-responsive">

        <!-- Filters -->
        <div class="d-flex flex-wrap gap-2 mb-3 align-items-center justify-content-between">
            <div class="input-group" style="max-width: 300px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input class="form-control" @bind="searchTerm" @bind:event="oninput" placeholder="Search categories..." />
            </div>

            @if (categories.Any(c => c.IsSelected))
            {
                <button class="btn btn-danger" @onclick="ConfirmBulkDelete">
                    <i class="bi bi-trash me-1"></i> Delete Selected
                </button>
            }
        </div>

        <!-- Table -->
        @if (PaginatedCategories.Any())
        {
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th><input type="checkbox" @onchange="ToggleAll" /></th>
                        <th @onclick="() => SortByColumn(nameof(MenuCategoryViewModel.Name))" style="cursor:pointer;">Name @SortIcon(nameof(MenuCategoryViewModel.Name))</th>
                        <th>Description</th>
                        <th>Parent</th>
                        <th @onclick="() => SortByColumn(nameof(MenuCategoryViewModel.DisplayOrder))" style="cursor:pointer;">Display Order @SortIcon(nameof(MenuCategoryViewModel.DisplayOrder))</th>
                        <th>Icon</th>
                        <th style="width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in PaginatedCategories)
                    {
                        <tr>
                            <td><input type="checkbox" @bind="c.IsSelected" /></td>
                            <td>@c.Name</td>
                            <td>@c.Description</td>
                            <td>@c.ParentCategoryName</td>
                            <td>@c.DisplayOrder</td>
                            <td>
                                @{
                                    var dataUrl = GetCategoryIconDataUrl(c);
                                }
                                @if (!string.IsNullOrEmpty(dataUrl))
                                {
                                    <img src="@dataUrl" style="width:24px;height:24px;object-fit:cover;border-radius:.2rem;" />
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => Edit(c)"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmSingleDelete(c.Id)"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">No categories found.</div>
        }

        <!-- Pagination -->
        <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
            <div>
                Showing @((currentPage - 1) * pageSize + 1) to
                @((currentPage - 1) * pageSize + PaginatedCategories.Count) of @FilteredCategories.Count categories
            </div>
            <div class="d-flex align-items-center gap-2">
                <label>Rows per page:</label>
                <select class="form-select form-select-sm" style="width: 80px;" @bind="pageSize">
                    <option>5</option>
                    <option>10</option>
                    <option>25</option>
                </select>
                <button class="btn btn-outline-secondary btn-sm" @onclick="PrevPage">Previous</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="NextPage">Next</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal & Confirmation -->
@if (showForm)
{
    <EditForm Model="formModel" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@((formModel.Id == 0) ? "Add Menu Category" : "Edit Menu Category")</h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <InputText class="form-control" @bind-Value="formModel.Name" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <InputText class="form-control" @bind-Value="formModel.Description" />
                        </div>

                        <div class="form-check mb-3">
                            <InputCheckbox class="form-check-input" @bind-Value="formModel.IsParentCategory" id="isParent" />
                            <label class="form-check-label" for="isParent">Is Parent Category</label>
                        </div>

                        @if (!formModel.IsParentCategory)
                        {
                            <div class="mb-3">
                                <label class="form-label">Parent Category</label>
                                <select class="form-select" @bind="formModel.ParentCategoryId">
                                    <option value="0">-- Select Parent --</option>
                                    @foreach (var p in ParentCategories)
                                    {
                                        <option value="@p.Id">@p.Name</option>
                                    }
                                </select>
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Display Order</label>
                            <InputNumber class="form-control" @bind-Value="formModel.DisplayOrder" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Upload Icon</label>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="PickIconAsync">
                                    <i class="bi bi-upload me-1"></i> Choose Image
                                </button>
                                @if (!string.IsNullOrEmpty(formModel.IconPath))
                                {
                                    <span class="align-self-center small text-muted">Saved as: @formModel.IconPath</span>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(iconPreviewDataUrl))
                            {
                                <div class="mt-2">
                                    <img src="@iconPreviewDataUrl" style="width:40px;height:40px;object-fit:cover;border-radius:.25rem;" />
                                </div>
                            }
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" @onclick="CloseModal">Cancel</button>
                        <button class="btn btn-primary" type="submit">Save</button>
                    </div>
                </div>
            </div>
        </div>
    </EditForm>
}


<ConfirmationModal Show="@showBulkDeleteConfirm"
                   Title="Delete Selected Categories"
                   Message="Are you sure you want to delete the selected categories?"
                   OnConfirm="ConfirmBulkDelete"
                   OnCancel="() => showBulkDeleteConfirm = false" />

<ConfirmationModal Show="@showSingleDeleteConfirm"
                   Title="Delete Category"
                   Message="Are you sure you want to delete this category?"
                   OnConfirm="ConfirmSingleDelete"
                   OnCancel="() => showSingleDeleteConfirm = false" />

@code {
    List<MenuCategoryViewModel> categories = new();
    List<MenuCategory> ParentCategories = new();
    MenuCategoryViewModel formModel = new();
    bool showForm = false;
    bool showBulkDeleteConfirm = false;
    bool showSingleDeleteConfirm = false;
    long selectedCategoryId = 0;

    string searchTerm = "";
    int currentPage = 1;
    int pageSize = 10;
    string sortColumn = nameof(MenuCategoryViewModel.DisplayOrder);
    bool sortAsc = true;

    protected override async Task OnInitializedAsync()
    {
        ParentCategories = await MenuCategoryService.GetParentCategoriesAsync();
        await LoadCategories();
    }

    async Task LoadCategories()
    {
        var all = await MenuCategoryService.GetAllAsync();
        categories = all.Select(MenuCategoryMapping.ToViewModel).ToList();
        ParentCategories = await MenuCategoryService.GetParentCategoriesAsync();
    }

    void ShowAddModal()
    {
        formModel = new();
        showForm = true;
    }

    void Edit(MenuCategoryViewModel c)
    {
        formModel = new MenuCategoryViewModel
        {
            Id = c.Id,
            Name = c.Name,
            Description = c.Description,
            DisplayOrder = c.DisplayOrder,
            IconPath = c.IconPath,
            ParentCategoryId = c.ParentCategoryId,
            IsParentCategory = c.IsParentCategory
        };
        showForm = true;
    }

    void CloseModal() => showForm = false;

    async Task Save()
    {
        try
        {
            var model = MenuCategoryMapping.ToDomainModel(formModel);

            if (model.Id == 0)
            {
                await MenuCategoryService.AddAsync(model);
                Notifier.Notify("✅ Category created", "success");
            }
            else
            {
                await MenuCategoryService.UpdateAsync(model);
                Notifier.Notify("✏️ Category updated", "info");
            }

            iconPreviewDataUrl = "";
            await LoadCategories();
            showForm = false;
        }
        catch (ApplicationException ex)
        {
            Logger.Log(ex.Message, "SaveCategory");
            Notifier.Notify($"❌ {ex.Message}", "error");
        }
        catch (Exception ex)
        {
            Logger.Log(ex.ToString(), "SaveCategory");
            Notifier.Notify($"❌ Unexpected error: {ex.Message}", "error");
        }
    }

    void ConfirmSingleDelete(long id)
    {
        selectedCategoryId = id;
        showSingleDeleteConfirm = true;
    }

    async Task ConfirmSingleDelete()
    {
        try
        {
            await MenuCategoryService.DeleteAsync(selectedCategoryId);
            Notifier.Notify("🗑 Deleted", "warning");
            await LoadCategories();
        }
        catch (Exception ex)
        {
            Logger.Log(ex.ToString(), "DeleteCategory");
            Notifier.Notify($"❌ Delete failed: {ex.Message}", "error");
        }
        finally
        {
            selectedCategoryId = 0;
            showSingleDeleteConfirm = false;
        }
    }

    async Task ConfirmBulkDelete()
    {
        var selectedIds = categories.Where(c => c.IsSelected).Select(c => c.Id).ToList();

        foreach (var id in selectedIds)
        {
            try { await MenuCategoryService.DeleteAsync(id); }
            catch (Exception ex)
            {
                Logger.Log(ex.ToString(), "BulkDeleteCategory");
                Notifier.Notify($"❌ Failed to delete ID {id}", "error");
            }
        }

        Notifier.Notify("🗑 Selected categories deleted", "warning");
        await LoadCategories();
        showBulkDeleteConfirm = false;
    }

    void ToggleAll(ChangeEventArgs e)
    {
        bool value = (bool)e.Value;
        foreach (var c in categories) c.IsSelected = value;
    }

    List<MenuCategoryViewModel> FilteredCategories => categories
        .Where(c => string.IsNullOrWhiteSpace(searchTerm) ||
            c.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            c.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .OrderBy(c => GetSortValue(c), sortAsc
            ? Comparer<object>.Default
            : Comparer<object>.Create((a, b) => Comparer<object>.Default.Compare(b, a)))
        .ToList();

    List<MenuCategoryViewModel> PaginatedCategories => FilteredCategories
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    object GetSortValue(MenuCategoryViewModel c) => sortColumn switch
    {
        nameof(MenuCategoryViewModel.Name) => c.Name,
        nameof(MenuCategoryViewModel.DisplayOrder) => c.DisplayOrder,
        _ => c.DisplayOrder
    };

    void SortByColumn(string column)
    {
        if (sortColumn == column)
            sortAsc = !sortAsc;
        else
        {
            sortColumn = column;
            sortAsc = true;
        }
    }

    void PrevPage() { if (currentPage > 1) currentPage--; }
    void NextPage() { if (currentPage < Math.Ceiling((double)FilteredCategories.Count / pageSize)) currentPage++; }

    RenderFragment SortIcon(string column) => __builder =>
    {
        if (sortColumn == column)
            __builder.AddMarkupContent(0, $"<i class=\"bi bi-chevron-{(sortAsc ? "up" : "down")}\"></i>");
    };

    async Task ExportToExcel()
    {
        using var workbook = new XLWorkbook();
        var sheet = workbook.Worksheets.Add("Categories");

        sheet.Cell(1, 1).Value = "Name";
        sheet.Cell(1, 2).Value = "Description";
        sheet.Cell(1, 3).Value = "Parent";
        sheet.Cell(1, 4).Value = "Order";

        for (int i = 0; i < FilteredCategories.Count; i++)
        {
            var c = FilteredCategories[i];
            sheet.Cell(i + 2, 1).Value = c.Name;
            sheet.Cell(i + 2, 2).Value = c.Description;
            sheet.Cell(i + 2, 3).Value = c.ParentCategoryName;
            sheet.Cell(i + 2, 4).Value = c.DisplayOrder;
        }

        using var stream = new MemoryStream();
        workbook.SaveAs(stream);
        stream.Seek(0, SeekOrigin.Begin);
        await TriggerDownload($"Categories_{DateTime.UtcNow:yyyyMMdd_HHmmss}.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", stream.ToArray());
    }

    async Task ExportToPdf()
    {
        var bytes = PdfExportService.GenerateCategoryPdf(categories);
        await TriggerDownload($"Categories_{DateTime.UtcNow:yyyyMMdd_HHmmss}.pdf", "application/pdf", bytes);
    }

    async Task TriggerDownload(string fileName, string mime, byte[] data)
    {
        using var streamRef = new DotNetStreamReference(new MemoryStream(data));
        await JS.InvokeVoidAsync("downloadFileFromStream", fileName, mime, streamRef);
    }

    string? iconPreviewDataUrl;

    async Task PickIconAsync()
    {
        try
        {
            var result = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = "Choose a category icon",
                FileTypes = FilePickerFileType.Images
            });

            if (result is null) return; // user cancelled

            // Validate extension
            var ext = Path.GetExtension(result.FileName).ToLowerInvariant();
            var allowed = new[] { ".png", ".jpg", ".jpeg", ".webp", ".gif" };
            if (!allowed.Contains(ext))
            {
                Notifier.Notify("Only PNG/JPG/JPEG/WEBP/GIF allowed.", "error");
                return;
            }

            // Copy to app data folder with a new guid filename
            var fileName = $"{Guid.NewGuid()}{ext}";
            var iconDir = Path.Combine(FileSystem.AppDataDirectory, "category-icons");
            Directory.CreateDirectory(iconDir);
            var destPath = Path.Combine(iconDir, fileName);

            using (var src = await result.OpenReadAsync())
            using (var dst = File.Create(destPath))
            {
                await src.CopyToAsync(dst);
            }

            // Store only the file name in DB (portable). You can also store a subfolder if you want.
            formModel.IconPath = Path.Combine("category-icons", fileName).Replace("\\", "/");

            // Build preview data URL
            iconPreviewDataUrl = await BuildDataUrlAsync(destPath);

            Notifier.Notify("✅ Icon selected", "success");
        }
        catch (Exception ex)
        {
            Logger.Log(ex.ToString(), "PickIcon");
            Notifier.Notify($"❌ Failed to pick icon: {ex.Message}", "error");
        }
    }

    async Task<string?> BuildDataUrlAsync(string absolutePath)
    {
        try
        {
            if (!File.Exists(absolutePath)) return null;
            var bytes = await File.ReadAllBytesAsync(absolutePath);
            var ext = Path.GetExtension(absolutePath).ToLowerInvariant();
            var mime = ext switch
            {
                ".png" => "image/png",
                ".jpg" => "image/jpeg",
                ".jpeg" => "image/jpeg",
                ".webp" => "image/webp",
                ".gif" => "image/gif",
                _ => "application/octet-stream"
            };
            return $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
        }
        catch (Exception ex)
        {
            Logger.Log(ex.ToString(), "BuildUrl");
            return null;
        }
    }

    string? GetCategoryIconDataUrl(MenuCategoryViewModel c)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(c.IconPath)) return null;
            var path = Path.Combine(FileSystem.AppDataDirectory, c.IconPath);
            if (!File.Exists(path)) return null;

            var bytes = File.ReadAllBytes(path);
            var ext = Path.GetExtension(path).ToLowerInvariant();
            var mime = ext switch
            {
                ".png" => "image/png",
                ".jpg" => "image/jpeg",
                ".jpeg" => "image/jpeg",
                ".webp" => "image/webp",
                ".gif" => "image/gif",
                _ => "application/octet-stream"
            };
            return $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
        }
        catch
        {
            return null;
        }
    }
}
