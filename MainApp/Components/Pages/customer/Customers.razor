@page "/customer/customers"
@inject ICustomerService CustomerService
@inject ICustomerAddressService AddressService
@inject NotificationService Notifier
@inject IJSRuntime JS
@inject FileLogger Logger

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h4>Customers</h4>
        <small class="text-muted">Manage your customers here</small>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-outline-success btn-sm" @onclick="ExportToExcel">
            <i class="bi bi-file-earmark-excel me-1"></i> Excel
        </button>
        <button class="btn btn-primary" @onclick="ShowAddModal">
            <i class="bi bi-plus-circle me-1"></i> Add Customer
        </button>
    </div>
</div>

<div class="card">
    <div class="card-body table-responsive">
        <div class="d-flex flex-wrap gap-2 mb-3 align-items-center justify-content-between">
            <div class="input-group" style="max-width: 300px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input class="form-control" @bind="searchTerm" @bind:event="oninput" placeholder="Search customers..." />
            </div>

            @if (customers.Any(c => c.IsSelected))
            {
                <button class="btn btn-danger" @onclick="() => showBulkDeleteConfirm = true">
                    <i class="bi bi-trash me-1"></i> Delete Selected
                </button>
            }
        </div>

        @if (PaginatedCustomers.Any())
        {
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th><input type="checkbox" @onchange="ToggleAll" /></th>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Membership</th>
                        <th>Loyalty</th>
                        <th>Credit</th>
                        <th style="width:150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in PaginatedCustomers)
                    {
                        <tr>
                            <td><input type="checkbox" @bind="c.IsSelected" /></td>
                            <td>@c.Name</td>
                            <td>@c.Phone</td>
                            <td>@c.Email</td>
                            <td>@c.MembershipName</td>
                            <td>@c.LoyaltyPoints</td>
                            <td>@c.CreditBalance</td>
                            <td>
                                <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => ShowDetail(c.Id)">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => Edit(c)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmSingleDelete(c.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">No customers found.</div>
        }
    </div>
</div>

<!-- Add/Edit Modal -->
@if (showForm)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <EditForm Model="formModel" OnValidSubmit="Save">
                    <div class="modal-header">
                        <h5 class="modal-title">@((formModel.Id == 0) ? "Add Customer" : "Edit Customer")</h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label>Name</label>
                                <InputText class="form-control" @bind-Value="formModel.Name" />
                            </div>
                            <div class="col-md-6">
                                <label>Phone</label>
                                <InputText class="form-control" @bind-Value="formModel.Phone" />
                            </div>
                            <div class="col-md-6">
                                <label>Email</label>
                                <InputText class="form-control" @bind-Value="formModel.Email" />
                            </div>
                            <div class="col-md-6">
                                <label>DOB</label>
                                <InputDate class="form-control" @bind-Value="formModel.DOB" />
                            </div>
                            <div class="col-md-6">
                                <label>Gender</label>
                                <select class="form-select" @bind="formModel.Gender">
                                    <option value="">-</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label>Source</label>
                                <InputText class="form-control" @bind-Value="formModel.Source" />
                            </div>
                            <div class="col-md-12">
                                <label>Notes</label>
                                <InputTextArea class="form-control" @bind-Value="formModel.Notes" />
                            </div>
                        </div>

                        <hr />
                        <h6>Addresses</h6>
                        <div class="mb-2">
                            <button class="btn btn-sm btn-outline-primary" @onclick="AddAddress"><i class="bi bi-plus-circle"></i> Add Address</button>
                        </div>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Label</th>
                                    <th>Flat/Office</th>
                                    <th>Street</th>
                                    <th>City</th>
                                    <th>Postal</th>
                                    <th>Country</th>
                                    <th>Default</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in formModel.Addresses)
                                {
                                    <tr>
                                        <td><InputText class="form-control" @bind-Value="a.Label" /></td>
                                        <td><InputText class="form-control" @bind-Value="a.FlatOrOffice" /></td>
                                        <td><InputText class="form-control" @bind-Value="a.Street" /></td>
                                        <td><InputText class="form-control" @bind-Value="a.City" /></td>
                                        <td><InputText class="form-control" @bind-Value="a.PostalCode" /></td>
                                        <td><InputText class="form-control" @bind-Value="a.Country" /></td>
                                        <td><InputCheckbox class="form-check-input" @bind-Value="a.IsDefault" /></td>
                                        <td><button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveAddress(a)"><i class="bi bi-trash"></i></button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" @onclick="CloseModal">Cancel</button>
                        <button class="btn btn-primary" type="submit">Save</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Detail Modal -->

@if (showDetail && selectedCustomer != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Customer Detail - @selectedCustomer.Name</h5>
                    <button type="button" class="btn-close" @onclick="CloseDetail"></button>
                </div>
                <div class="modal-body">
                    <dl class="row">
                        <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@selectedCustomer.Name</dd>
                        <dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@selectedCustomer.Phone</dd>
                        <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@selectedCustomer.Email</dd>
                        <dt class="col-sm-3">DOB</dt><dd class="col-sm-9">@selectedCustomer.DOB</dd>
                        <dt class="col-sm-3">Gender</dt><dd class="col-sm-9">@selectedCustomer.Gender</dd>
                        <dt class="col-sm-3">Membership</dt><dd class="col-sm-9">@selectedCustomer.MembershipName</dd>
                        <dt class="col-sm-3">Loyalty Points</dt><dd class="col-sm-9">@selectedCustomer.LoyaltyPoints</dd>
                        <dt class="col-sm-3">Credit Balance</dt><dd class="col-sm-9">@selectedCustomer.CreditBalance</dd>
                        <dt class="col-sm-3">Source</dt><dd class="col-sm-9">@selectedCustomer.Source</dd>
                        <dt class="col-sm-3">Notes</dt><dd class="col-sm-9">@selectedCustomer.Notes</dd>
                    </dl>

                    <h6>Addresses</h6>
                    @if (selectedCustomer.Addresses.Any())
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Label</th>
                                    <th>Flat/Office</th>
                                    <th>Street</th>
                                    <th>City</th>
                                    <th>Postal</th>
                                    <th>Country</th>
                                    <th>Default</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in selectedCustomer.Addresses)
                                {
                                    <tr>
                                        <td>@a.Label</td>
                                        <td>@a.FlatOrOffice</td>
                                        <td>@a.Street</td>
                                        <td>@a.City</td>
                                        <td>@a.PostalCode</td>
                                        <td>@a.Country</td>
                                        <td>@(a.IsDefault ? "✔" : "✘")</td>
                                        <td>@(a.IsActive ? "Active" : "Inactive")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="alert alert-info">No addresses found.</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDetail"><i class="bi bi-x"></i> Close</button>
                </div>
            </div>
        </div>
    </div>
}


<ConfirmationModal Show="@showBulkDeleteConfirm"
                   Title="Delete Selected Customers"
                   Message="Are you sure you want to delete the selected customers?"
                   OnConfirm="ConfirmBulkDelete"
                   OnCancel="() => showBulkDeleteConfirm = false" />

<ConfirmationModal Show="@showSingleDeleteConfirm"
                   Title="Delete Customer"
                   Message="Are you sure you want to delete this customer?"
                   OnConfirm="ConfirmSingleDelete"
                   OnCancel="() => showSingleDeleteConfirm = false" />

@code {
    List<CustomerViewModel> customers = new();
    CustomerViewModel formModel = new();

    bool showForm = false;
    bool showBulkDeleteConfirm = false;
    bool showSingleDeleteConfirm = false;
    long selectedCustomerId = 0;

    string searchTerm = "";
    int currentPage = 1;
    int pageSize = 10;

    protected override async Task OnInitializedAsync() => await LoadCustomers();

    async Task LoadCustomers()
    {
        var all = await CustomerService.GetAllAsync();
        customers = all.Select(CustomerMappings.ToViewModel).ToList();

        // Load addresses for each
        foreach (var c in customers)
        {
            var addr = await AddressService.GetByCustomerAsync(c.Id);
            c.Addresses = addr.Select(CustomerAddressMapping.ToViewModel).ToList();
        }
    }

    void ShowAddModal()
    {
        formModel = new();
        showForm = true;
    }

    void Edit(CustomerViewModel c)
    {
        formModel = new CustomerViewModel
        {
            Id = c.Id,
            Name = c.Name,
            Phone = c.Phone,
            Email = c.Email,
            DOB = c.DOB,
            Gender = c.Gender,
            MembershipId = c.MembershipId,
            MembershipName = c.MembershipName,
            LoyaltyPoints = c.LoyaltyPoints,
            CreditBalance = c.CreditBalance,
            Source = c.Source,
            Notes = c.Notes,
            Addresses = c.Addresses.Select(a => new CustomerAddressViewModel
            {
                Id = a.Id,
                CustomerId = a.CustomerId,
                Label = a.Label,
                FlatOrOffice = a.FlatOrOffice,
                Street = a.Street,
                City = a.City,
                PostalCode = a.PostalCode,
                Country = a.Country,
                IsDefault = a.IsDefault,
                IsActive = a.IsActive
            }).ToList()
        };
        showForm = true;
    }

    void CloseModal() => showForm = false;

    async Task Save()
    {
        try
        {
            var entity = formModel.ToEntity();
            if (formModel.Id == 0)
            {
                var id = await CustomerService.AddAsync(entity);
                foreach (var addr in formModel.Addresses)
                {
                    addr.CustomerId = id;
                    await AddressService.AddAsync(addr.ToEntity());
                }
                Notifier.Notify("✅ Customer created successfully", "success");
            }
            else
            {
                await CustomerService.UpdateAsync(entity);
                // Simplify: delete & re-add addresses
                foreach (var addr in await AddressService.GetByCustomerAsync(formModel.Id))
                    await AddressService.DeleteAsync(addr.Id);

                foreach (var addr in formModel.Addresses)
                {
                    addr.CustomerId = formModel.Id;
                    await AddressService.AddAsync(addr.ToEntity());
                }
                Notifier.Notify("✏️ Customer updated successfully", "info");
            }
            await LoadCustomers();
            showForm = false;
        }
        catch (Exception ex)
        {
            Logger.Log(ex.ToString(), "SaveCustomer");
            Notifier.Notify($"❌ Save failed: {ex.Message}", "error");
        }
    }

    void ConfirmSingleDelete(long id)
    {
        selectedCustomerId = id;
        showSingleDeleteConfirm = true;
    }

    async Task ConfirmSingleDelete()
    {
        try
        {
            await CustomerService.DeleteAsync(selectedCustomerId);
            Notifier.Notify("🗑 Customer deleted", "warning");
            await LoadCustomers();
        }
        catch (Exception ex)
        {
            Logger.Log(ex.ToString(), "DeleteCustomer");
            Notifier.Notify($"❌ Delete failed: {ex.Message}", "error");
        }
        finally
        {
            selectedCustomerId = 0;
            showSingleDeleteConfirm = false;
        }
    }

    async Task ConfirmBulkDelete()
    {
        foreach (var id in customers.Where(c => c.IsSelected).Select(c => c.Id).ToList())
        {
            await CustomerService.DeleteAsync(id);
        }
        Notifier.Notify("🗑 Selected customers deleted", "warning");
        await LoadCustomers();
        showBulkDeleteConfirm = false;
    }

    void ToggleAll(ChangeEventArgs e)
    {
        bool value = (bool)e.Value;
        foreach (var c in customers) c.IsSelected = value;
    }

    List<CustomerViewModel> FilteredCustomers => customers
        .Where(c => string.IsNullOrWhiteSpace(searchTerm) || c.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || c.Phone.Contains(searchTerm))
        .ToList();

    List<CustomerViewModel> PaginatedCustomers => FilteredCustomers
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    void PrevPage() { if (currentPage > 1) currentPage--; }
    void NextPage() { if (currentPage < Math.Ceiling((double)FilteredCustomers.Count / pageSize)) currentPage++; }

    async Task ExportToExcel()
    {
        using var wb = new XLWorkbook();
        var ws = wb.Worksheets.Add("Customers");
        ws.Cell(1, 1).Value = "Name";
        ws.Cell(1, 2).Value = "Phone";
        ws.Cell(1, 3).Value = "Email";
        ws.Cell(1, 4).Value = "Membership";
        ws.Cell(1, 5).Value = "LoyaltyPoints";
        ws.Cell(1, 6).Value = "CreditBalance";

        for (int i = 0; i < FilteredCustomers.Count; i++)
        {
            var c = FilteredCustomers[i];
            ws.Cell(i + 2, 1).Value = c.Name;
            ws.Cell(i + 2, 2).Value = c.Phone;
            ws.Cell(i + 2, 3).Value = c.Email;
            ws.Cell(i + 2, 4).Value = c.MembershipName;
            ws.Cell(i + 2, 5).Value = c.LoyaltyPoints;
            ws.Cell(i + 2, 6).Value = c.CreditBalance;
        }

        ws.Columns().AdjustToContents();

        using var stream = new MemoryStream();
        wb.SaveAs(stream);
        stream.Seek(0, SeekOrigin.Begin);

        var fileName = $"Customers_{DateTime.UtcNow:yyyyMMdd_HHmmss}.xlsx";
        await TriggerDownload(fileName, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", stream.ToArray());
    }



    async Task TriggerDownload(string fileName, string mime, byte[] data)
    {
        using var streamRef = new DotNetStreamReference(new MemoryStream(data));
        await JS.InvokeVoidAsync("downloadFileFromStream", fileName, mime, streamRef);
    }

    void AddAddress()
    {
        formModel.Addresses.Add(new CustomerAddressViewModel());
    }

    void RemoveAddress(CustomerAddressViewModel address)
    {
        formModel.Addresses.Remove(address);
    }

    bool showDetail = false;
    CustomerViewModel? selectedCustomer = null;

    async Task ShowDetail(long id)
    {
        var entity = await CustomerService.GetByIdAsync(id);
        if (entity != null)
        {
            selectedCustomer = entity.ToViewModel();
            var addr = await AddressService.GetByCustomerAsync(entity.Id);
            selectedCustomer.Addresses = addr.Select(CustomerAddressMapping.ToViewModel).ToList();
            showDetail = true;
        }
    }

    void CloseDetail() => showDetail = false;

}
