@page "/user/roles"
@inject IRoleService RoleService
@inject NotificationService Notifier
@inject IJSRuntime JS
@inject FileLogger Logger

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h4>Roles & Permissions</h4>
        <small class="text-muted">Manage your roles here</small>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-outline-success btn-sm" @onclick="ExportToExcel">
            <i class="bi bi-file-earmark-excel me-1"></i> Excel
        </button>
        <button class="btn btn-outline-danger btn-sm" @onclick="ExportToPdf">
            <i class="bi bi-file-earmark-pdf me-1"></i> PDF
        </button>
        <button class="btn btn-primary" @onclick="ShowAddModal">
            <i class="bi bi-plus-circle me-1"></i> Add Role
        </button>
    </div>
</div>

<div class="card">
    <div class="card-body table-responsive">

        <!-- Search box and other controls -->
        <div class="d-flex flex-wrap gap-2 mb-3 align-items-center justify-content-between">
            <div class="input-group" style="max-width: 300px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input class="form-control" @bind="searchTerm" @bind:event="oninput" placeholder="Search roles..." />
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <select class="form-select" style="width: 160px;" @bind="selectedStatusFilter">
                    <option value="All">All</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>

                @if (roles.Any(r => r.IsSelected))
                {
                    <button class="btn btn-danger" @onclick="ConfirmMultiDelete">
                        <i class="bi bi-trash me-1"></i> Delete Selected
                    </button>
                }
            </div>
        </div>

        <!--table-->
        @if (PaginatedRoles?.Count > 0)
        {
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 40px;">
                            <input type="checkbox" @onchange="ToggleAll" />
                        </th>
                        <th @onclick="() => SortByColumn(nameof(RoleViewModel.Name))" style="cursor:pointer;">
                            Role Name
                            @if (sortColumn == nameof(RoleViewModel.Name))
                            {
                                <i class="bi bi-chevron-@(sortAsc ? "up" : "down") ms-1"></i>
                            }
                        </th>
                        <th>System Role</th>
                        <th>Permission Assigned</th>
                        <th @onclick="() => SortByColumn(nameof(RoleViewModel.CreatedAt))" style="cursor:pointer;">
                            Created Date
                            @if (sortColumn == nameof(RoleViewModel.CreatedAt))
                            {
                                <i class="bi bi-chevron-@(sortAsc ? "up" : "down") ms-1"></i>
                            }
                        </th>
                        <th>Status</th>
                        <th style="width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in PaginatedRoles)
                    {
                        <tr>
                            <td><input type="checkbox" @bind="role.IsSelected" /></td>
                            <td>@role.Name</td>
                            <td>@(role.IsSystemRole ? "✔️" : "✘")</td>
                            <td>@(role.IsPermissionAssigned ? "✔️" : "✘")</td>
                            <td>@role.CreatedAt</td>
                            <td>
                                <span class="badge @(role.IsActive ? "bg-success" : "bg-secondary")">
                                    @(role.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditRole(role)"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteRole(role.Id)"><i class="bi bi-trash"></i></button>
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="@(() => NavigateToPermissionAssignment(role.Id))">
                                    <i class="bi bi-shield-lock"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">No roles found.</div>
        }

        <!--pagination-->
        <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
            <div>
                Showing @((currentPage - 1) * pageSize + 1) to @((currentPage - 1) * pageSize + PaginatedRoles.Count) of @FilteredRoles.Count roles
            </div>
            <div class="d-flex align-items-center gap-2">
                <label>Rows per page:</label>
                <select class="form-select form-select-sm" style="width: 80px;" @bind="pageSize">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="25">25</option>
                </select>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="PrevPage">Previous</button>
                        </li>
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="NextPage">Next</button>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
@if (showForm)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <EditForm Model="roleForm" OnValidSubmit="SaveRole">
                    <div class="modal-header">
                        <h5 class="modal-title">@((roleForm.Id == 0) ? "Create Role" : "Edit Role")</h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label>Role Name</label>
                            <InputText class="form-control" @bind-Value="roleForm.Name" />
                        </div>
                        <div class="form-check form-switch mb-2">
                            <InputCheckbox class="form-check-input" @bind-Value="roleForm.IsSystemRole" />
                            <label class="form-check-label">System Role</label>
                        </div>
                        @* <div class="form-check form-switch mb-2">
                            <InputCheckbox class="form-check-input" @bind-Value="roleForm.IsPermissionAssigned" />
                            <label class="form-check-label">Permissions Assigned</label>
                        </div> *@
                        <div class="form-check form-switch mb-2">
                            <InputCheckbox class="form-check-input" @bind-Value="roleForm.IsActive" />
                            <label class="form-check-label">Active</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal"><i class="bi bi-x me-1"></i>Cancel</button>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-floppy me-1"></i>Save</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<ConfirmationModal 
    Show="@showConfirmModal"
    Title="Delete Role"
    Message="Are you sure you want to delete this role?"
    OnConfirm="ConfirmDelete"
    OnCancel="CancelDelete" />

<ConfirmationModal Show="@showBulkDeleteConfirm"
    Title="Delete Selected Roles"
    Message="Are you sure you want to delete all selected roles?"
    OnConfirm="ConfirmBulkDelete"
    OnCancel="CancelBulkDelete" />


@code {
    List<RoleViewModel> roles = new();
    RoleViewModel roleForm = new();
    bool showForm = false;

    protected override async Task OnInitializedAsync() => await LoadRoles();

    async Task LoadRoles() => roles = (await RoleService.GetAllAsync()).Select(RoleMapping.ToViewModel)
        .ToList();

    void ShowAddModal()
    {
        roleForm = new();
        showForm = true;
    }

    void EditRole(RoleViewModel r)
    {
        roleForm = new RoleViewModel
        {
            Id = r.Id,
            Name = r.Name,
            IsSystemRole = r.IsSystemRole,
            IsPermissionAssigned = r.IsPermissionAssigned,
            IsActive = r.IsActive
        };
        showForm = true;
    }

    void CloseModal() => showForm = false;

    async Task SaveRole()
    {
        try
        {
            var domainRole = RoleMapping.ToDomainModel(roleForm);

            if (roleForm.Id == 0)
            {
                await RoleService.AddAsync(domainRole);
                Notifier.Notify("✅ Role created successfully", "success");
            }
            else
            {
                await RoleService.UpdateAsync(domainRole);
                Notifier.Notify("✏️ Role updated successfully", "info");
            }

            showForm = false;
            await LoadRoles();
            if ((currentPage - 1) * pageSize >= FilteredRoles.Count)
                currentPage = Math.Max(1, totalPages);
        }
        catch (ApplicationException ex)
        {
            Logger.Log(ex.Message, "SaveRole - ApplicationException");
            Notifier.Notify($"❌ {ex.Message}", "error");
        }
        catch (Exception ex)
        {
            Logger.Log(ex.ToString(), "SaveRole - Unexpected Exception");
            Notifier.Notify($"❌ An unexpected error occurred : {ex.Message}", "error");
        }
    }

    long deleteRoleId = 0;
    bool showConfirmModal = false;

    void DeleteRole(long id)
    {
        deleteRoleId = id;
        showConfirmModal = true;
    }

    async Task ConfirmDelete()
    {
        try
        {
            await RoleService.DeleteAsync(deleteRoleId);
            Notifier.Notify("🗑 Role deleted", "warning");
            await LoadRoles();
            if ((currentPage - 1) * pageSize >= FilteredRoles.Count)
                currentPage = Math.Max(1, totalPages);
        }
        catch (ApplicationException ex)
        {
            Logger.Log(ex.Message, "DeleteRole - Application Exception");
            Notifier.Notify($"❌ {ex.Message}", "error");
        }
        catch (Exception ex)
        {
            Logger.Log(ex.ToString(), "DeleteRole - Unhandled Exception");
            Notifier.Notify($"❌ Failed to delete role due to unexpected error : {ex.Message}", "error");
        }
        finally
        {
            deleteRoleId = 0;
            showConfirmModal = false;
        }
    }

    void CancelDelete()
    {
        deleteRoleId = 0;
        showConfirmModal = false;
    }

    string searchTerm = "";
    string sortColumn = nameof(RoleViewModel.CreatedAt);
    bool sortAsc = false;
    string selectedStatusFilter = "All";

    List<RoleViewModel> FilteredRoles => roles
    .Where(r =>
        (string.IsNullOrWhiteSpace(searchTerm) || r.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) &&
        (selectedStatusFilter == "All" ||
         (selectedStatusFilter == "Active" && r.IsActive) ||
         (selectedStatusFilter == "Inactive" && !r.IsActive))
    )
    .OrderBy(r => GetSortValue(r), sortAsc ? 
    Comparer<object>.Default : Comparer<object>
    .Create((a, b) => Comparer<object>.Default.Compare(b, a)))
    .ToList();

    object GetSortValue(RoleViewModel r) => sortColumn switch
    {
        nameof(RoleViewModel.Name) => r.Name,
        nameof(RoleViewModel.CreatedAt) => r.CreatedAt,
        _ => r.Name
    };

    void SortByColumn(string column)
    {
        if (sortColumn == column)
            sortAsc = !sortAsc;
        else
        {
            sortColumn = column;
            sortAsc = true;
        }
    }

    void ToggleAll(ChangeEventArgs e)
    {
        bool value = (bool)e.Value;
        foreach (var r in roles)
        {
            r.IsSelected = value;
        }
    }

    bool showBulkDeleteConfirm = false;

    void ConfirmMultiDelete()
    {
        showBulkDeleteConfirm = true;
    }

    async Task ConfirmBulkDelete()
    {
        var selectedIds = roles.Where(r => r.IsSelected).Select(r => r.Id).ToList();

        foreach (var id in selectedIds)
        {
            try
            {
                await RoleService.DeleteAsync(id);
            }
            catch (Exception ex)
            {
                Logger.Log(ex.ToString(), "BulkDeleteRole - Unhandled Exception");
                Notifier.Notify($"❌ Failed to delete Role ID {id}: {ex.Message}", "error");
            }
        }

        Notifier.Notify("🗑 Selected roles deleted", "warning");
        await LoadRoles();
        if ((currentPage - 1) * pageSize >= FilteredRoles.Count)
            currentPage = Math.Max(1, totalPages);
        showBulkDeleteConfirm = false;
    }

    void CancelBulkDelete()
    {
        showBulkDeleteConfirm = false;
    }

    int currentPage = 1;
    int pageSize = 10;

    int totalPages => (int)Math.Ceiling((double)FilteredRoles.Count / pageSize);

    List<RoleViewModel> PaginatedRoles => FilteredRoles
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    void PrevPage()
    {
        if (currentPage > 1)
            currentPage--;
    }

    void NextPage()
    {
        if (currentPage < totalPages)
            currentPage++;
    }

    async Task ExportToExcel()
    {
        using var workbook = new XLWorkbook();
        var worksheet = workbook.Worksheets.Add("Roles");

        // Headers
        worksheet.Cell(1, 1).Value = "Role Name";
        worksheet.Cell(1, 2).Value = "System Role";
        worksheet.Cell(1, 3).Value = "Permission Assigned";
        worksheet.Cell(1, 4).Value = "Status";

        // Data
        for (int i = 0; i < FilteredRoles.Count; i++)
        {
            var r = FilteredRoles[i];
            worksheet.Cell(i + 2, 1).Value = r.Name;
            worksheet.Cell(i + 2, 2).Value = r.IsSystemRole ? "Yes" : "No";
            worksheet.Cell(i + 2, 3).Value = r.IsPermissionAssigned ? "Yes" : "No";
            worksheet.Cell(i + 2, 4).Value = r.IsActive ? "Active" : "Inactive";
        }

        // Formatting
        worksheet.Columns().AdjustToContents();

        // Save to stream
        using var stream = new MemoryStream();
        workbook.SaveAs(stream);
        stream.Seek(0, SeekOrigin.Begin);

        var fileName = $"Roles_{DateTime.UtcNow:yyyyMMdd_HHmmss}.xlsx";
        await TriggerDownload(fileName, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", stream.ToArray());
    }

    async Task ExportToPdf()
    {
        var domainRoles = roles.Select(RoleMapping.ToDomainModel).ToList();
        var bytes = PdfExportService.GenerateRolesPdf(domainRoles);
        var fileName = $"Roles_{DateTime.UtcNow:yyyyMMdd_HHmmss}.pdf";

        await TriggerDownload(fileName, "application/pdf", bytes);
    }

    // Common trigger for download
    async Task TriggerDownload(string fileName, string mime, byte[] data)
    {
        using var streamRef = new DotNetStreamReference(new MemoryStream(data));
        await JS.InvokeVoidAsync("downloadFileFromStream", fileName, mime, streamRef);
    }

    [Inject] NavigationManager Nav { get; set; }

    void NavigateToPermissionAssignment(long roleId)
    {
        Nav.NavigateTo($"/user/assign-roles-permissions/{roleId}");
    }
}
