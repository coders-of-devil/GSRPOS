@page "/user/users"
@inject IUserService UserService
@inject NotificationService Notifier
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject FileLogger Logger

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h4>Users</h4>
        <small class="text-muted">Manage application users</small>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-outline-success btn-sm" @onclick="ExportToExcel">
            <i class="bi bi-file-earmark-excel me-1"></i> Excel
        </button>
        <button class="btn btn-outline-danger btn-sm" @onclick="ExportToPdf">
            <i class="bi bi-file-earmark-pdf me-1"></i> PDF
        </button>
        <button class="btn btn-primary" @onclick="ShowAddModal">
            <i class="bi bi-plus-circle me-1"></i> Add User
        </button>
    </div>
</div>
<hr />

<div class="card">
    <div class="card-body table-responsive">

        <!-- Search box and other controls -->
        <div class="d-flex flex-wrap gap-2 mb-3 align-items-center justify-content-between">
            <div class="input-group" style="max-width: 300px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input class="form-control" @bind="searchTerm" @bind:event="oninput" placeholder="Search roles..." />
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <select class="form-select" style="width: 160px;" @bind="selectedStatusFilter">
                    <option value="All">All</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>

                @if (users.Any(r => r.IsSelected))
                {
                    <button class="btn btn-danger" @onclick="ConfirmMultiDelete">
                        <i class="bi bi-trash me-1"></i> Delete Selected
                    </button>
                }
            </div>
        </div>

        <!--table-->
        @if (PaginatedUsers?.Count > 0)
        {
            <div class="scrollable-table-container">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 40px;">
                                <input type="checkbox" @onchange="ToggleAll" />
                            </th>
                            <th @onclick="() => SortByColumn(nameof(UserViewModel.Fullname))" style="cursor:pointer;">
                                Name
                                @if (sortColumn == nameof(UserViewModel.Fullname))
                                {
                                    <i class="bi bi-chevron-@(sortAsc ? "up" : "down") ms-1"></i>
                                }
                            </th>
                            <th>Email</th>
                            <th>Phone No</th>
                            <th>Last Login </th>
                            <th @onclick="() => SortByColumn(nameof(UserViewModel.CreatedAt))" style="cursor:pointer;">
                                Created Date
                                @if (sortColumn == nameof(UserViewModel.CreatedAt))
                                {
                                    <i class="bi bi-chevron-@(sortAsc ? "up" : "down") ms-1"></i>
                                }
                            </th>
                            <th>Status</th>
                            <th>Remarks</th>
                            <th style="width: 150px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var role in PaginatedUsers)
                        {
                            <tr>
                                <td><input type="checkbox" @bind="role.IsSelected" /></td>
                                <td>@role.Fullname</td>
                                <td>@role.Email</td>
                                <td>@role.PhoneNo</td>
                                <td>@role.LastLogin</td>
                                <td>@role.CreatedAt</td>
                                <td>
                                    <span class="badge @(role.IsActive ? "bg-success" : "bg-secondary")">
                                        @(role.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>@role.Remarks</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditUser(role)"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteUser(role.Id)"><i class="bi bi-trash"></i></button>
                                    <button class="btn btn-sm btn-outline-warning me-1">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">No roles found.</div>
        }

        <!--pagination-->
        <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
            <div>
                Showing @((currentPage - 1) * pageSize + 1) to @((currentPage - 1) * pageSize + PaginatedUsers.Count) of @FilteredUsers.Count roles
            </div>
            <div class="d-flex align-items-center gap-2">
                <label>Rows per page:</label>
                <select class="form-select form-select-sm" style="width: 80px;" @bind="pageSize">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="25">25</option>
                </select>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="PrevPage">Previous</button>
                        </li>
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="NextPage">Next</button>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

@if (showForm)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <EditForm Model="userForm" OnValidSubmit="SaveUser">
                    <div class="modal-header">
                        <h5 class="modal-title">@((userForm.Id == 0) ? "Create User" : "Edit User")</h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label>Full Name</label>
                            <InputText class="form-control" @bind-Value="userForm.Fullname" />
                        </div>
                        <div class="mb-3">
                            <label>Email</label>
                            <InputText class="form-control" @bind-Value="userForm.Email" />
                        </div>
                        <div class="mb-3">
                            <label>Phone No</label>
                            <InputText class="form-control" @bind-Value="userForm.PhoneNo" />
                        </div>
                        <div class="mb-3">
                            <label>Username</label>
                            <InputText class="form-control" @bind-Value="userForm.Username" />
                        </div>
                        <div class="mb-3">
                            <label>Password</label>
                            <InputText class="form-control" @bind-Value="userForm.Password" />
                        </div>
                        <div class="mb-3">
                            <label>Hint</label>
                            <InputText class="form-control" @bind-Value="userForm.Hint" />
                        </div>
                        <div class="form-check form-switch mb-2">
                            <InputCheckbox class="form-check-input" @bind-Value="userForm.IsActive" />
                            <label class="form-check-label">Active</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal"><i class="bi bi-x me-1"></i>Cancel</button>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-floppy me-1"></i>Save</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<ConfirmationModal Show="@showConfirmModal"
                   Title="Delete Role"
                   Message="Are you sure you want to delete this role?"
                   OnConfirm="ConfirmDelete"
                   OnCancel="CancelDelete" />

<ConfirmationModal Show="@showBulkDeleteConfirm"
                   Title="Delete Selected Roles"
                   Message="Are you sure you want to delete all selected roles?"
                   OnConfirm="ConfirmBulkDelete"
                   OnCancel="CancelBulkDelete" />


@code {
    List<UserViewModel> users = new();
    UserViewModel userForm = new();
    bool showForm = false;
    string searchTerm = "";
    string sortColumn = nameof(UserViewModel.CreatedAt);
    bool sortAsc = false;
    string selectedStatusFilter = "All";

    protected override async Task OnInitializedAsync() => await LoadUsers();

    async Task LoadUsers() => users = (await UserService.GetAllUsersAsync()).Select(UserMapping.ToViewModel)
        .ToList();

    void ShowAddModal()
    {
        userForm = new();
        showForm = true;
    }

    void EditUser(UserViewModel r)
    {
        userForm = new UserViewModel
        {
            Id = r.Id,
            Fullname = r.Fullname,
            Email = r.Email,
            PhoneNo = r.PhoneNo,
            Username = r.Username,
            Password = r.Password,
            Hint = r.Hint,
            IsActive = r.IsActive
        };
        showForm = true;
    }

    void CloseModal() => showForm = false;

    async Task SaveUser()
    {
        try
        {
            var domainRole = UserMapping.ToDomainModel(userForm);

            if (userForm.Id == 0)
            {
                await UserService.CreateUserAsync(domainRole);
                Notifier.Notify("✅ User created successfully", "success");
            }
            else
            {
                await UserService.UpdateUserAsync(domainRole);
                Notifier.Notify("✏️ User updated successfully", "info");
            }

            showForm = false;
            await LoadUsers();
            if ((currentPage - 1) * pageSize >= FilteredUsers.Count)
                currentPage = Math.Max(1, totalPages);
        }
        catch (ApplicationException ex)
        {
            Logger.Log(ex.Message, "SaveUser - ApplicationException");
            Notifier.Notify($"❌ {ex.Message}", "error");
        }
        catch (Exception ex)
        {
            Logger.Log(ex.ToString(), "SaveUser - Unexpected Exception");
            Notifier.Notify($"❌ An unexpected error occurred : {ex.Message}", "error");
        }
    }

    long deleteUserId = 0;
    bool showConfirmModal = false;

    void DeleteUser(long id)
    {
        deleteUserId = id;
        showConfirmModal = true;
    }

    async Task ConfirmDelete()
    {
        try
        {
            await UserService.DeleteUserAsync(deleteUserId);
            Notifier.Notify("🗑 User deleted", "warning");
            await LoadUsers();
            if ((currentPage - 1) * pageSize >= FilteredUsers.Count)
                currentPage = Math.Max(1, totalPages);
        }
        catch (ApplicationException ex)
        {
            Logger.Log(ex.Message, "DeleteUser - Application Exception");
            Notifier.Notify($"❌ {ex.Message}", "error");
        }
        catch (Exception ex)
        {
            Logger.Log(ex.ToString(), "DeleteUser - Unhandled Exception");
            Notifier.Notify($"❌ Failed to delete user due to unexpected error : {ex.Message}", "error");
        }
        finally
        {
            deleteUserId = 0;
            showConfirmModal = false;
        }
    }

    void CancelDelete()
    {
        deleteUserId = 0;
        showConfirmModal = false;
    }

    List<UserViewModel> FilteredUsers => users
    .Where(r =>
        (string.IsNullOrWhiteSpace(searchTerm) || r.Fullname.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) &&
        (selectedStatusFilter == "All" ||
         (selectedStatusFilter == "Active" && r.IsActive) ||
         (selectedStatusFilter == "Inactive" && !r.IsActive))
    )
    .OrderBy(r => GetSortValue(r), sortAsc ?
    Comparer<object>.Default : Comparer<object>
    .Create((a, b) => Comparer<object>.Default.Compare(b, a)))
    .ToList();

    object GetSortValue(UserViewModel r) => sortColumn switch
    {
        nameof(UserViewModel.Fullname) => r.Fullname,
        nameof(UserViewModel.CreatedAt) => r.CreatedAt,
        _ => r.Fullname
    };

    void SortByColumn(string column)
    {
        if (sortColumn == column)
            sortAsc = !sortAsc;
        else
        {
            sortColumn = column;
            sortAsc = true;
        }
    }

    void ToggleAll(ChangeEventArgs e)
    {
        bool value = (bool)e.Value;
        foreach (var r in users)
        {
            r.IsSelected = value;
        }
    }

    bool showBulkDeleteConfirm = false;

    void ConfirmMultiDelete()
    {
        showBulkDeleteConfirm = true;
    }

    async Task ConfirmBulkDelete()
    {
        var selectedIds = users.Where(r => r.IsSelected).Select(r => r.Id).ToList();

        foreach (var id in selectedIds)
        {
            try
            {
                await UserService.DeleteUserAsync(id);
            }
            catch (Exception ex)
            {
                Logger.Log(ex.ToString(), "BulkDeleteUser - Unhandled Exception");
                Notifier.Notify($"❌ Failed to delete User ID {id}: {ex.Message}", "error");
            }
        }

        Notifier.Notify("🗑 Selected users deleted", "warning");
        await LoadUsers();
        if ((currentPage - 1) * pageSize >= FilteredUsers.Count)
            currentPage = Math.Max(1, totalPages);
        showBulkDeleteConfirm = false;
    }

    void CancelBulkDelete()
    {
        showBulkDeleteConfirm = false;
    }

    int currentPage = 1;
    int pageSize = 10;

    int totalPages => (int)Math.Ceiling((double)FilteredUsers.Count / pageSize);

    List<UserViewModel> PaginatedUsers => FilteredUsers
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    void PrevPage()
    {
        if (currentPage > 1)
            currentPage--;
    }

    void NextPage()
    {
        if (currentPage < totalPages)
            currentPage++;
    }

    async Task ExportToExcel()
    {
        using var workbook = new XLWorkbook();
        var worksheet = workbook.Worksheets.Add("Users");

        // Headers
        worksheet.Cell(1, 1).Value = "Name";
        worksheet.Cell(1, 2).Value = "Email";
        worksheet.Cell(1, 3).Value = "Phone";
        worksheet.Cell(1, 4).Value = "Status";

        // Data
        for (int i = 0; i < FilteredUsers.Count; i++)
        {
            var r = FilteredUsers[i];
            worksheet.Cell(i + 2, 1).Value = r.Fullname;
            worksheet.Cell(i + 2, 2).Value = r.Email;
            worksheet.Cell(i + 2, 3).Value = r.PhoneNo;
            worksheet.Cell(i + 2, 4).Value = r.IsActive ? "Active" : "Inactive";
        }

        worksheet.Columns().AdjustToContents();

        // Save to stream
        using var stream = new MemoryStream();
        workbook.SaveAs(stream);
        stream.Seek(0, SeekOrigin.Begin);

        var fileName = $"Users_{DateTime.UtcNow:yyyyMMdd_HHmmss}.xlsx";
        await TriggerDownload(fileName, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", stream.ToArray());
    }

    async Task ExportToPdf()
    {
        var bytes = PdfExportService.GenerateUsersPdf(users);
        var fileName = $"Users_{DateTime.UtcNow:yyyyMMdd_HHmmss}.pdf";

        await TriggerDownload(fileName, "application/pdf", bytes);
    }

    // Common trigger for download
    async Task TriggerDownload(string fileName, string mime, byte[] data)
    {
        using var streamRef = new DotNetStreamReference(new MemoryStream(data));
        await JS.InvokeVoidAsync("downloadFileFromStream", fileName, mime, streamRef);
    }
}
