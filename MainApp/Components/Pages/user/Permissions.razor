@page "/user/permissions"
@inject IPermissionService PermissionService
@inject IPermissionGroupService PermissionGroupService
@inject NotificationService Notifier
@inject IJSRuntime JS
@inject FileLogger Logger

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h4>Permissions</h4>
        <small class="text-muted">Manage your permissions here</small>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-outline-success btn-sm" @onclick="ExportToExcel">
            <i class="bi bi-file-earmark-excel me-1"></i> Excel
        </button>
        <button class="btn btn-outline-danger btn-sm" @onclick="ExportToPdf">
            <i class="bi bi-file-earmark-pdf me-1"></i> PDF
        </button>
        <button class="btn btn-primary" @onclick="ShowAddModal">
            <i class="bi bi-plus-circle me-1"></i> Add Permission
        </button>
    </div>
</div>


<div class="card">
    <div class="card-body table-responsive">
        <div class="d-flex flex-wrap gap-2 mb-3 align-items-center justify-content-between">
            <div class="input-group" style="max-width: 300px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input class="form-control" @bind="searchTerm" @bind:event="oninput" placeholder="Search permissions..." />
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <select class="form-select" style="width: 160px;" @bind="selectedGroupId">
                    <option value="0">All Groups</option>
                    @foreach (var g in Groups)
                    {
                        <option value="@g.Id">@g.Name</option>
                    }
                </select>

                <select class="form-select" style="width: 160px;" @bind="selectedAction">
                    <option value="">All Actions</option>
                    @foreach (var act in Enum.GetValues<PermissionActionEnum>())
                    {
                        <option value="@act">@act</option>
                    }
                </select>

                @if (permissions.Any(p => p.IsSelected))
                {
                    <button class="btn btn-danger" @onclick="ConfirmBulkDelete">
                        <i class="bi bi-trash me-1"></i> Delete Selected
                    </button>
                }
            </div>
        </div>

        @if (PaginatedPermissions.Any())
        {
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th style="width: 40px;"><input type="checkbox" @onchange="ToggleAll" /></th>
                        <th @onclick="() => SortByColumn(nameof(PermissionViewModel.GroupName))" style="cursor:pointer;">
                            Group
                            @if (sortColumn == nameof(PermissionViewModel.GroupName))
                            {
                                <i class="bi bi-chevron-@(sortAsc ? "up" : "down") ms-1"></i>
                            }
                        </th>
                        <th @onclick="() => SortByColumn(nameof(PermissionViewModel.Action))" style="cursor:pointer;">
                            Action
                            @if (sortColumn == nameof(PermissionViewModel.Action))
                            {
                                <i class="bi bi-chevron-@(sortAsc ? "up" : "down") ms-1"></i>
                            }
                        </th>
                        <th>Description</th>
                        <th @onclick="() => SortByColumn(nameof(PermissionViewModel.CreatedAt))" style="cursor:pointer;">
                            Created Date
                            @if (sortColumn == nameof(PermissionViewModel.CreatedAt))
                            {
                                <i class="bi bi-chevron-@(sortAsc ? "up" : "down") ms-1"></i>
                            }
                        </th>
                        <th style="width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in PaginatedPermissions)
                    {
                        <tr>
                            <td><input type="checkbox" @bind="p.IsSelected" /></td>
                            <td>@p.GroupName</td>
                            <td>@p.Action</td>
                            <td>@p.Description</td>
                            <td>@p.CreatedAt</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => Edit(p)"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmSingleDelete(p.Id)"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">No permissions found.</div>
        }

        <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
            <div>
                Showing @((currentPage - 1) * pageSize + 1) to
                @((currentPage - 1) * pageSize + PaginatedPermissions.Count) of @FilteredPermissions.Count permissions
            </div>
            <div class="d-flex align-items-center gap-2">
                <label>Rows per page:</label>
                <select class="form-select form-select-sm" style="width: 80px;" @bind="pageSize">
                    <option>5</option>
                    <option>10</option>
                    <option>25</option>
                </select>
                <button class="btn btn-outline-secondary btn-sm" @onclick="PrevPage">Previous</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="NextPage">Next</button>
            </div>
        </div>
    </div>
</div>

@if (showForm)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <EditForm Model="formModel" OnValidSubmit="Save">
                    <div class="modal-header">
                        <h5 class="modal-title">@((formModel.Id == 0) ? "Create" : "Edit") Permission</h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Permission Group</label>
                            <select class="form-select" @bind="formModel.PermissionGroupId">
                                <option value="0">-Select Group-</option>
                                @foreach (var g in Groups)
                                {
                                    <option value="@g.Id">@g.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Action</label>
                            <select class="form-select" @bind="formModel.Action">
                                <option value="">-Select Action-</option>
                                @foreach (var act in Enum.GetValues<PermissionActionEnum>())
                                {
                                    <option value="@act">@act</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <InputText class="form-control" @bind-Value="formModel.Description" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" @onclick="CloseModal">Cancel</button>
                        <button class="btn btn-primary" type="submit">Save</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<ConfirmationModal Show="@showBulkDeleteConfirm"
                   Title="Delete Selected Permissions"
                   Message="Are you sure you want to delete the selected permissions?"
                   OnConfirm="ConfirmBulkDelete"
                   OnCancel="() => showBulkDeleteConfirm = false" />

<ConfirmationModal Show="@showSingleDeleteConfirm"
                   Title="Delete Permission"
                   Message="Are you sure you want to delete this permission?"
                   OnConfirm="ConfirmSingleDelete"
                   OnCancel="() => showSingleDeleteConfirm = false" />

@code {
    List<PermissionViewModel> permissions = new();
    List<PermissionGroup> Groups = new();
    PermissionViewModel formModel = new();
    bool showForm = false;
    bool showBulkDeleteConfirm = false;
    bool showSingleDeleteConfirm = false;
    long selectedPermissionId = 0;

    string searchTerm = "";
    int currentPage = 1;
    int pageSize = 10;
    long selectedGroupId = 0;
    string selectedAction = "";

    string sortColumn = nameof(PermissionViewModel.CreatedAt);
    bool sortAsc = true;

    protected override async Task OnInitializedAsync()
    {
        Groups = await PermissionGroupService.GetAllAsync();
        await LoadPermissions();
    }

    async Task LoadPermissions()
    {
        var all = await PermissionService.GetAllAsync();
        permissions = all.Select(PermissionMapping.ToViewModel).ToList();
    }

    void ShowAddModal()
    {
        formModel = new();
        showForm = true;
    }

    void Edit(PermissionViewModel p)
    {
        formModel = new PermissionViewModel
        {
            Id = p.Id,
            Action = p.Action,
            Description = p.Description,
            PermissionGroupId = p.PermissionGroupId
        };
        showForm = true;
    }

    void CloseModal() => showForm = false;

    async Task Save()
    {
        try
        {
            var model = PermissionMapping.ToDomainModel(formModel);
            if (formModel.Id == 0)
            {
                await PermissionService.AddAsync(model);
                Notifier.Notify("✅ Created successfully", "success");
            }
            else
            {
                await PermissionService.UpdateAsync(model);
                Notifier.Notify("✏️ Updated successfully", "info");
            }

            await LoadPermissions();
            showForm = false;
        }
        catch (ApplicationException ex)
        {
            Logger.Log(ex.Message, "SavePermission - Application Exception");
            Notifier.Notify($"❌ {ex.Message}", "error");
        }
        catch (Exception ex)
        {
            Logger.Log(ex.ToString(), "SavePermission - Unhandled Exception");
            Notifier.Notify($"❌ Unexpected error: {ex.Message}", "error");
        }
    }

    void ConfirmSingleDelete(long id)
    {
        selectedPermissionId = id;
        showSingleDeleteConfirm = true;
    }

    async Task ConfirmSingleDelete()
    {
        try
        {
            await PermissionService.DeleteAsync(selectedPermissionId);
            Notifier.Notify("🗑 Deleted", "warning");
            await LoadPermissions();
        }
        catch (Exception ex)
        {
            Logger.Log(ex.ToString(), "DeletePermission - Unhandled Exception");
            Notifier.Notify($"❌ Delete failed: {ex.Message}", "error");
        }
        finally
        {
            selectedPermissionId = 0;
            showSingleDeleteConfirm = false;
        }
    }

    async Task ConfirmBulkDelete()
    {
        var selectedIds = permissions.Where(p => p.IsSelected).Select(p => p.Id).ToList();

        foreach (var id in selectedIds)
        {
            try
            {
                await PermissionService.DeleteAsync(id);
            }
            catch (Exception ex)
            {
                Logger.Log(ex.ToString(), "BulkDeletePermission - Unhandled Exception");
                Notifier.Notify($"❌ Failed to delete ID {id}: {ex.Message}", "error");
            }
        }

        Notifier.Notify("🗑 Selected permissions deleted", "warning");
        await LoadPermissions();
        showBulkDeleteConfirm = false;
    }

    void ToggleAll(ChangeEventArgs e)
    {
        bool value = (bool)e.Value;
        foreach (var p in permissions) p.IsSelected = value;
    }

    object GetSortValue(PermissionViewModel p) => sortColumn switch
    {
        nameof(PermissionViewModel.GroupName) => p.GroupName,
        nameof(PermissionViewModel.Action) => p.Action,
        nameof(PermissionViewModel.CreatedAt) => p.CreatedAt,
        _ => p.CreatedAt
    };

    List<PermissionViewModel> FilteredPermissions => permissions
    .Where(p =>
        (string.IsNullOrWhiteSpace(searchTerm) ||
         p.GroupName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
         p.Action.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) &&
        (selectedGroupId == 0 || p.PermissionGroupId == selectedGroupId) &&
        (string.IsNullOrEmpty(selectedAction) || p.Action == selectedAction))
    .OrderBy(p => GetSortValue(p), sortAsc
        ? Comparer<object>.Default
        : Comparer<object>.Create((a, b) => Comparer<object>.Default.Compare(b, a)))
    .ToList();

    void SortByColumn(string column)
    {
        if (sortColumn == column)
            sortAsc = !sortAsc;
        else
        {
            sortColumn = column;
            sortAsc = true;
        }
    }

    List<PermissionViewModel> PaginatedPermissions => FilteredPermissions
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    void PrevPage() { if (currentPage > 1) currentPage--; }
    void NextPage() { if (currentPage < Math.Ceiling((double)FilteredPermissions.Count / pageSize)) currentPage++; }

    async Task ExportToExcel()
    {
        using var workbook = new XLWorkbook();
        var worksheet = workbook.Worksheets.Add("Permissions");

        worksheet.Cell(1, 1).Value = "Group";
        worksheet.Cell(1, 2).Value = "Action";
        worksheet.Cell(1, 3).Value = "Description";

        for (int i = 0; i < FilteredPermissions.Count; i++)
        {
            var p = FilteredPermissions[i];
            worksheet.Cell(i + 2, 1).Value = p.GroupName;
            worksheet.Cell(i + 2, 2).Value = p.Action;
            worksheet.Cell(i + 2, 3).Value = p.Description;
        }

        worksheet.Columns().AdjustToContents();

        using var stream = new MemoryStream();
        workbook.SaveAs(stream);
        stream.Seek(0, SeekOrigin.Begin);

        var fileName = $"Permissions_{DateTime.UtcNow:yyyyMMdd_HHmmss}.xlsx";
        await TriggerDownload(fileName, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", stream.ToArray());
    }

    async Task ExportToPdf()
    {
        var domain = permissions.Select(p => new PermissionDTO()
        {
            Groupname = p.GroupName,
            Action = p.Action,
            Description = p.Description,
            CreatedAt = p.CreatedAt
        }).ToList();
        var bytes = PdfExportService.GeneratePermissionPdf(domain);
        var fileName = $"Permissions_{DateTime.UtcNow:yyyyMMdd_HHmmss}.pdf";
        await TriggerDownload(fileName, "application/pdf", bytes);
    }

    async Task TriggerDownload(string fileName, string mime, byte[] data)
    {
        using var streamRef = new DotNetStreamReference(new MemoryStream(data));
        await JS.InvokeVoidAsync("downloadFileFromStream", fileName, mime, streamRef);
    }
}
